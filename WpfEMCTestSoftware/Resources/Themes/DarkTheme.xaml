<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!-- 暗色主题 · Deep Space Industrial -->
    <!-- 参考：深空蓝/暗夜灰工业风，翠绿强调色 -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- 主色 / 强调色 (翠绿) -->
    <Color x:Key="AccentColor">#10B981</Color>
    <Color x:Key="AccentHoverColor">#34D399</Color>
    <Color x:Key="AccentLightColor">#064E3B</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <!-- 背景色系 (深空蓝黑) -->
    <Color x:Key="PageBackgroundColor">#0D1117</Color>
    <Color x:Key="SurfaceColor">#161B22</Color>
    <Color x:Key="SurfaceAltColor">#0D1117</Color>
    <Color x:Key="CardBackgroundColor">#1C2128</Color>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>

    <!-- 文字色系 -->
    <Color x:Key="TextPrimaryColor">#F0F6FC</Color>
    <Color x:Key="TextSecondaryColor">#8B949E</Color>
    <Color x:Key="TextMutedColor">#6E7681</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <!-- 边框色系 -->
    <Color x:Key="BorderColor">#21262D</Color>
    <Color x:Key="BorderStrongColor">#30363D</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <!-- 控件专用 -->
    <Color x:Key="InputBackgroundColor">#0D1117</Color>
    <Color x:Key="InputBorderColor">#30363D</Color>
    <Color x:Key="InputFocusBorderColor">#10B981</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>

    <!-- 按钮 -->
    <Color x:Key="ButtonPrimaryBgColor">#10B981</Color>
    <Color x:Key="ButtonPrimaryFgColor">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBgColor">#21262D</Color>
    <Color x:Key="ButtonSecondaryFgColor">#C9D1D9</Color>
    <Color x:Key="ButtonDangerBgColor">#490202</Color>
    <Color x:Key="ButtonDangerFgColor">#F85149</Color>
    <SolidColorBrush x:Key="ButtonPrimaryBgBrush" Color="{StaticResource ButtonPrimaryBgColor}"/>
    <SolidColorBrush x:Key="ButtonPrimaryFgBrush" Color="{StaticResource ButtonPrimaryFgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="{StaticResource ButtonSecondaryBgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryFgBrush" Color="{StaticResource ButtonSecondaryFgColor}"/>
    <SolidColorBrush x:Key="ButtonDangerBgBrush" Color="{StaticResource ButtonDangerBgColor}"/>
    <SolidColorBrush x:Key="ButtonDangerFgBrush" Color="{StaticResource ButtonDangerFgColor}"/>

    <!-- 状态色 -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#D29922</Color>
    <Color x:Key="ErrorColor">#F85149</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Header 区域 (深蓝黑，参考图1) -->
    <Color x:Key="HeaderBgColor">#0D1117</Color>
    <Color x:Key="HeaderFgColor">#F0F6FC</Color>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="{StaticResource HeaderFgColor}"/>

    <!-- 状态栏 -->
    <Color x:Key="StatusBarBgColor">#0D1117</Color>
    <Color x:Key="StatusBarFgColor">#8B949E</Color>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="{StaticResource StatusBarBgColor}"/>
    <SolidColorBrush x:Key="StatusBarFgBrush" Color="{StaticResource StatusBarFgColor}"/>

    <!-- 图表相关 -->
    <Color x:Key="ChartBgColor">#161B22</Color>
    <Color x:Key="ChartGridColor">#21262D</Color>
    <Color x:Key="ChartAxesColor">#8B949E</Color>
    <SolidColorBrush x:Key="ChartBgBrush" Color="{StaticResource ChartBgColor}"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}"/>
    <SolidColorBrush x:Key="ChartAxesBrush" Color="{StaticResource ChartAxesColor}"/>

    <!-- 阴影效果 -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Panel Header（暗色卡片标题栏） -->
    <Color x:Key="PanelHeaderBgColor">#1C2128</Color>
    <Color x:Key="PanelHeaderFgColor">#10B981</Color>
    <SolidColorBrush x:Key="PanelHeaderBgBrush" Color="{StaticResource PanelHeaderBgColor}"/>
    <SolidColorBrush x:Key="PanelHeaderFgBrush" Color="{StaticResource PanelHeaderFgColor}"/>

    <!-- MaterialDesign 颜色覆盖 -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF"/>

</ResourceDictionary>
