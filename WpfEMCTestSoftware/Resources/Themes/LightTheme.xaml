<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!-- 浅色主题 · Clean Professional -->
    <!-- ═══════════════════════════════════════════ -->

    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentLightColor">#DBEAFE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <Color x:Key="PageBackgroundColor">#F1F5F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F8FAFC</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>

    <Color x:Key="TextPrimaryColor">#1E293B</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#CBD5E1</Color>
    <Color x:Key="InputFocusBorderColor">#2563EB</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>

    <Color x:Key="ButtonPrimaryBgColor">#2563EB</Color>
    <Color x:Key="ButtonPrimaryFgColor">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBgColor">#F1F5F9</Color>
    <Color x:Key="ButtonSecondaryFgColor">#1E293B</Color>
    <Color x:Key="ButtonDangerBgColor">#FEE2E2</Color>
    <Color x:Key="ButtonDangerFgColor">#DC2626</Color>
    <SolidColorBrush x:Key="ButtonPrimaryBgBrush" Color="{StaticResource ButtonPrimaryBgColor}"/>
    <SolidColorBrush x:Key="ButtonPrimaryFgBrush" Color="{StaticResource ButtonPrimaryFgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="{StaticResource ButtonSecondaryBgColor}"/>
    <SolidColorBrush x:Key="ButtonSecondaryFgBrush" Color="{StaticResource ButtonSecondaryFgColor}"/>
    <SolidColorBrush x:Key="ButtonDangerBgBrush" Color="{StaticResource ButtonDangerBgColor}"/>
    <SolidColorBrush x:Key="ButtonDangerFgBrush" Color="{StaticResource ButtonDangerFgColor}"/>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Header: 浅色用深蓝底 (保持视觉层次) -->
    <Color x:Key="HeaderBgColor">#1E40AF</Color>
    <Color x:Key="HeaderFgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="{StaticResource HeaderFgColor}"/>

    <Color x:Key="StatusBarBgColor">#2563EB</Color>
    <Color x:Key="StatusBarFgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="{StaticResource StatusBarBgColor}"/>
    <SolidColorBrush x:Key="StatusBarFgBrush" Color="{StaticResource StatusBarFgColor}"/>

    <Color x:Key="ChartBgColor">#FFFFFF</Color>
    <Color x:Key="ChartGridColor">#E2E8F0</Color>
    <Color x:Key="ChartAxesColor">#64748B</Color>
    <SolidColorBrush x:Key="ChartBgBrush" Color="{StaticResource ChartBgColor}"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}"/>
    <SolidColorBrush x:Key="ChartAxesBrush" Color="{StaticResource ChartAxesColor}"/>

    <Color x:Key="ShadowColor">#1E293B</Color>
    <Color x:Key="PanelHeaderBgColor">#2563EB</Color>
    <Color x:Key="PanelHeaderFgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="PanelHeaderBgBrush" Color="{StaticResource PanelHeaderBgColor}"/>
    <SolidColorBrush x:Key="PanelHeaderFgBrush" Color="{StaticResource PanelHeaderFgColor}"/>

    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF"/>
</ResourceDictionary>
