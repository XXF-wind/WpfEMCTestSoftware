<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    x:Class="WpfEMCTestSoftware.Views.Dialogs.AlertDialog"
    DataContext="{Binding AlertDialogViewModel, Source={StaticResource Locator}}"    
    mc:Ignorable="d" FontSize="28"
    Title="AlertDialog" Height="400" Width="650" WindowStartupLocation="CenterOwner" 
    WindowStyle="None" Background="{x:Null}" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="4" BorderThickness="1" BorderBrush="#e0e0e0" Margin="0,0,0,1">
        <Border.Background>
            <ImageBrush ImageSource="/Images/提示框.png"/>
        </Border.Background>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="107*" />
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Image Source="pack://application:,,,/Company.UI.Controls;component/Image/Sinpel.png" 
                       Margin="38,0,0,0" HorizontalAlignment="Left" Width="133" Height="41" VerticalAlignment="Top"/>
                <TextBlock Margin="0,45,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" 
                           TextWrapping="Wrap" FontSize="36" FontFamily="Arial Black" Text="{Binding Title}" 
                           Width="388" Height="42" FontWeight="Bold" TextAlignment="Center" Foreground="#FFF1E3E3" />
                <Grid Margin="0,102,0,33">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="71*"/>
                        <ColumnDefinition Width="126*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" 
                               FontSize="36" FontFamily="Arial Black" Text="{Binding LabelFirst}" Width="209" 
                               Height="46" FontWeight="Bold" TextAlignment="Right" Foreground="#FFF1E3E3"
                               Visibility="{Binding LabelFirst.Length,
                        Converter={StaticResource valueToVisibilityConverter}}"/>
                    
                    <ComboBox x:Name="cbxItems" ItemsSource="{Binding Items}" SelectedItem ="{Binding Item}"
                              VerticalAlignment="Center" UseLayoutRounding="False" Cursor="Hand" Height="45"
                              FontSize="36" Grid.Column="1" Visibility="{Binding Items.Count,
                        Converter={StaticResource valueToVisibilityConverter}}" Margin="10,0,104,0"/>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="36" FontFamily="Arial Black" Width="209" Height="45" TextAlignment="Right" 
                           Text="{Binding LabelSecond}" Foreground="#FFF1E3E3" Grid.Row="1"/>
                    <TextBox Margin="10,0,104,0" FontSize="36" Background="#FFDEF1FB" Grid.Row="1" Height="45" 
                             Text="{Binding Data,Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="1" />
                </Grid>

            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Controls:RoundedButton x:Name="btnOK" Margin="0,10,0,18" Foreground="#FFFFFFFF" 
                                        FontSize="18" Content="{DynamicResource ConfirmTitle}" Width="94"
                                        HorizontalAlignment="Center" Background="#0054C5" Cursor="Hand"
                                        Command="{Binding DialogCommand}" Grid.Column="1" CornerRadius="5"
                                        CommandParameter="true" Click="btnOK_Click"/>
                <Controls:RoundedButton x:Name="btnCancel" Margin="158,10,0,18" Foreground="#FFFFFFFF" 
                                        FontSize="18" CommandParameter="false" Content="{DynamicResource CencelTitle}"
                                        Width="94" HorizontalAlignment="Left" Background="#FFF35343" Cursor="Hand" 
                                        Command="{Binding DialogCommand}" CornerRadius="5" Click="btnCancel_Click" />

            </Grid>
        </Grid>
    </Border>
</Window>
