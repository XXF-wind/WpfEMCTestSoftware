<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    x:Class="WpfEMCTestSoftware.Views.UserManagementPage"
    mc:Ignorable="d" 
    d:DesignHeight="893" d:DesignWidth="1840"
    Title="UserManagementPage">
    <Page.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="TileItemTemplate">
                <Border Margin="5" BorderBrush="#E0E0E0" BorderThickness="3" CornerRadius="8" MinWidth="170"
                        Background="{Binding IsActive, Converter={StaticResource BoolenToBackColorConverter}}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <!-- 默认背景 -->
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <!-- 绑定父级ListViewItem的IsSelected属性 -->
                                <DataTrigger Binding="{Binding IsSelected, 
                                    RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                             Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FF0F6AFD"/>
                                                <GradientStop Color="#FF66FFDF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 根据ListViewItem的IsSelected动态切换背景色 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2">
                        <TextBlock Text="{Binding UserName}" FontSize="48" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="5,0,5,0">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#FFF7F7F7"/>
                                    <Style.Triggers>
                                        <!-- 绑定父级ListViewItem的IsSelected属性 -->
                                        <DataTrigger Binding="{Binding IsSelected,
                                            RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="#FFED4809"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Level, Converter={StaticResource ValueToPermissionsConverter}}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="36"
                                   Foreground="#FFFAFF99"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- 清空ListViewItem默认选中样式（避免双重高亮） -->
            <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--密码输入框-->
            <Style TargetType="{x:Type PasswordBox}">
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="true">
                        <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Page.DataContext>
        <Binding Path="UserManagementViewModel" Source="{StaticResource Locator}"/>
    </Page.DataContext>
    <Grid Cursor="Hand">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Viewbox>
            <ListView ItemTemplate="{StaticResource TileItemTemplate}" 
                  ItemContainerStyle="{StaticResource ListViewItemStyle}" 
                  ItemsSource="{Binding UserList}"
                  SelectedItem="{Binding SelectUser}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                  Background="{x:Null}" Margin="5,5,5,5" Width="550" Height="880">
                <i:Interaction.Triggers>
                    <!-- 将SelectionChanged事件绑定到命令 -->
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <!-- 禁用横向滚动，强制WrapPanel换行 -->
                <!-- 替换默认的StackPanel为WrapPanel（平铺布局核心） -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Viewbox>
        <Grid Grid.Column="1" Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="72">
                <Controls:StatusIconTextButton Margin="20,0,0,0" IconSize="72" IsHitTestVisible="False" 
                                               BorderBrush="{x:Null}" Background="{x:Null}" FontSize="48" 
                                               Foreground="#FF050029" Label="{DynamicResource NameTitle}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               IconKind="Account"/>
                <TextBlock Text="{Binding SelectUser.UserName}" FontSize="48" FontWeight="Bold" 
                           HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Center"
                           Foreground="#FF050029"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                <Controls:StatusIconTextButton Margin="20,0,0,0" IconSize="72" IsHitTestVisible="False" 
                                               BorderBrush="{x:Null}" Background="{x:Null}" FontSize="48" 
                                               Foreground="#FF050029" Label="{DynamicResource RoleTitle}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               IconKind="accounttagoutline"/>
                <TextBlock Text="{Binding SelectUser.Level, Converter={StaticResource ValueToPermissionsConverter}}"
                           Margin="50,0,0,0" VerticalAlignment="Center" FontSize="48" FontWeight="Bold" 
                           Foreground="#FF050029"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center">
                <Controls:StatusIconTextButton Margin="20,0,0,0" IconSize="72" IsHitTestVisible="False" 
                                               BorderBrush="{x:Null}" Background="{x:Null}" FontSize="48" 
                                               Foreground="#FF050029" Label="{DynamicResource ExpireTitle}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               IconKind="TimerSand"/>
                <TextBlock Text="{Binding SelectUser.ExpirationDate}" Margin="20,0,0,0" FontSize="48" 
                           VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF050029"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="4" VerticalAlignment="Center">
                <CheckBox BorderBrush="{x:Null}" Background="{x:Null}" FontSize="48" Margin="50,0,0,0"
                          Foreground="#FF050029" Content="{DynamicResource EnableTitle}" 
                          VerticalAlignment="Center" IsChecked="{Binding SelectUser.IsActive}" Cursor="Hand"/>
                <Controls:StatusIconTextButton Margin="150,0,0,0" IconSize="72" FontSize="48" 
                                               BorderBrush="{x:Null}" Background="{x:Null}"
                                               Foreground="#FFFF553A" IconKind="LockReset"
                                               Label="{DynamicResource ChangePasswordTitle}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Command="{Binding ChangePasswordCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="5" VerticalAlignment="Center"
                        Visibility="{Binding SelectUser.UserName,
                Converter={StaticResource stringToVisibilityConverter}}">
                <Controls:StatusIconTextButton Margin="50,0,0,0" IconSize="72" BorderBrush="{x:Null}" 
                                               Background="#0CFFFFFF" FontSize="48" Foreground="#FFD5FFAD"
                                               Label="{DynamicResource SaveTitle}" HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" IconKind="ContentSave"
                                               Command="{Binding SaveUserCommand}"/>
                <Controls:StatusIconTextButton Margin="150,0,0,0" IconSize="72" BorderBrush="{x:Null}" 
                                               Background="#0CFFFFFF" FontSize="48" Foreground="#FFFF591A"
                                               Label="{DynamicResource DelTitle}" HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" IconKind="TrashCanOutline"
                                               Command="{Binding DeleteUserCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="3" VerticalAlignment="Center"
                        Visibility="{Binding SelectUser.ValidityPeriod,
                Converter={StaticResource valueToVisibilityConverter}}">
                <Controls:StatusIconTextButton Margin="20,0,0,0" IconSize="72" IsHitTestVisible="False" 
                                               BorderBrush="{x:Null}" Background="{x:Null}" FontSize="48" 
                                               Foreground="#FF050029" IconKind="timetable"
                                               Label="{DynamicResource ValidityPeriodTitle}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                <TextBlock Text="{Binding ExpirationDate}" Margin="20,0,0,0" VerticalAlignment="Center" 
                           FontSize="48" FontWeight="Bold" Foreground="#FF050029"/>
                <mah:NumericUpDown Background="{x:Null}" Width="134" FontSize="42" Height="66"
                                   Style="{StaticResource NoButton}" Foreground="#FF050029"
                                   Value="{Binding SelectUser.ValidityPeriod, Mode=TwoWay}"
                                   VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontSize="48" FontWeight="Bold" 
                           Foreground="#FF050029" Text="d"/>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsChangePwd, Converter={StaticResource myBoolToVisibilityConverter}}" 
              Grid.Column="2">
            <PasswordBox x:Name="pwdBox1"  materialDesign:PasswordBoxAssist.Password="{Binding NewPassword,
                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Background="#33023E3D" PasswordChar="*"
                         MaxLength="20" VerticalContentAlignment="Center" HorizontalAlignment="Center"
                         Width="446" Margin="0,272,0,0" Height="75" VerticalAlignment="Top" FontSize="48"/>
            <Controls:StatusIconTextButton IconSize="72" IsHitTestVisible="False" BorderBrush="{x:Null}" 
                                           Background="{x:Null}" FontSize="48" Foreground="White" 
                                           Label="{DynamicResource NewPasswordTitle}" IconKind="lockplusoutline" 
                                           Margin="58,162,57,659" HorizontalContentAlignment="Left"/>
            <PasswordBox x:Name="pwdBox2" 
                         materialDesign:PasswordBoxAssist.Password="{Binding TwoStepVerificationPwd,
                Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="446" Margin="0,520,0,0"
                         Background="#33023E3D" PasswordChar="*" MaxLength="20" 
                         VerticalContentAlignment="Center" HorizontalAlignment="Center" 
                         Height="76" VerticalAlignment="Top" FontSize="48"/>
            <Controls:StatusIconTextButton IconSize="72" IsHitTestVisible="False" FontSize="48" 
                                           BorderBrush="{x:Null}" Background="{x:Null}" 
                                           IconKind="shieldlockoutline" Foreground="White"
                                           Label="{DynamicResource EnterAgainTitle}" 
                                           Margin="58,410,57,411" HorizontalContentAlignment="Left"/>
            <TextBlock FontSize="32" Foreground="Red" Text="{DynamicResource TwoPwdNotMatchMsg}"
                       FontFamily="Yu Gothic" Margin="0,601,0,0" Height="88" VerticalAlignment="Top"                        
                        HorizontalAlignment="Center" Width="445" TextAlignment="Right" FontWeight="Bold">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource PasswordMatchConverter}">
                        <Binding ElementName="pwdBox1" Path="(materialDesign:PasswordBoxAssist.Password)"/>
                        <Binding ElementName="pwdBox2" Path="(materialDesign:PasswordBoxAssist.Password)"/>
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>

        </Grid>
    </Grid>
</Page>
