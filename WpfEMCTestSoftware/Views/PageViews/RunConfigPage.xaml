<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ad="https://github.com/Dirkster99/AvalonDock"
    xmlns:UseControls="clr-namespace:Company.UI.Controls.UseControls;assembly=Company.UI.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:modules="clr-namespace:WpfEMCTestSoftware.Models.DisplayModules"
    x:Class="WpfEMCTestSoftware.Views.RunConfigPage"
    DataContext="{Binding RunConfigViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d" FontSize="16"
    d:DesignHeight="893" d:DesignWidth="1840"
    Title="RunConfigPage">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding PageUnloadedCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- ==================================================
         运行页资源：统一配色 / 卡片阴影 / 参数行 / 表格样式
         主色 #1E88E5  标题色 #1F4E79  背景 #F5F9FD
         ================================================== -->
    <Page.Resources>
        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.16" Color="#1F4E79"/>

        <!-- 卡片容器（参数卡、表格卡统一外观：白底 + 圆角 + 细边框 + 阴影） -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- 卡片标题（左侧竖色条 + 标题文字，模板里配 Border 使用） -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F4E79"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <!-- 卡片标题左侧竖色条 -->
        <Style x:Key="CardAccentBar" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 参数名 -->
        <Style x:Key="ParamNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7A8D"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 参数值 -->
        <Style x:Key="ParamValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#22303F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 表头单元格（配深蓝渐变表头，白字） -->
        <Style x:Key="TableHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,7"/>
        </Style>
        <!-- 数据单元格 -->
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>

        <!-- 摘要统计小胶囊（总点数 / 超标点 / 最大余量） -->
        <Style x:Key="StatChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- 顶部状态条小图标按钮统一外观 -->
        <Style x:Key="TopBarIconButton" TargetType="Controls:StatusIconTextButton">
            <Setter Property="Label" Value=""/>
            <Setter Property="IconSize" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E88E5"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#F5F9FD"/>
                <GradientStop Color="#E6F0F9" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 三列：左（页签控制栏） | 中（顶部状态条+图表区+按钮条） | 右（测试信息+参数卡） -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             主区（中列）：① 顶部状态条  ② 图表模块区  ③ 底部按钮条
             ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== ① 顶部状态条【通用骨架，所有测试一样】 ========== -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,6"
                    BorderBrush="#DCE8F2" BorderThickness="1" Effect="{StaticResource CardShadow}"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 模板管理：刷新 / 选择模板 / 编辑 / 新建 / 删除 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Controls:StatusIconTextButton Style="{StaticResource TopBarIconButton}"
                            IconKind="Refresh"
                            Command="{Binding RunButtonOperCommand}" CommandParameter="3"/>
                        <ComboBox Width="330" VerticalAlignment="Center" Margin="6,0,2,0"
                                  ItemsSource="{Binding TestTemplates, Mode=TwoWay}"
                                  SelectedItem="{Binding CurSelectedTestProject, Mode=TwoWay}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding TestComboxSelectChangeCommand}"
                                                           PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                        <Controls:StatusIconTextButton Style="{StaticResource TopBarIconButton}"
                            IconKind="EditBox"
                            Command="{Binding RunButtonOperCommand}" CommandParameter="0"/>
                        <Controls:StatusIconTextButton Style="{StaticResource TopBarIconButton}"
                            IconKind="AddBox"
                            Command="{Binding RunButtonOperCommand}" CommandParameter="1"/>
                        <Controls:StatusIconTextButton Style="{StaticResource TopBarIconButton}"
                            IconKind="DeleteCircle" Foreground="#E57373"
                            Command="{Binding RunButtonOperCommand}" CommandParameter="2"/>
                    </StackPanel>

                    <!-- 右侧状态区：模式切换 / 在线设备 / 状态灯 / 经过时间 / 进度 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- 在线设备（说明书：测试前必须确认仪器在线） -->
                        <Border Background="#E8F5E9" CornerRadius="10" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanConnect" Width="14" Height="14"
                                                         Foreground="#43A047" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Run Text="在线 "/><Run Text="{Binding BaseTasks.OnLineCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>



                        <!-- 测试经过时间 -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TimerOutline" Width="16" Height="16"
                                                     Foreground="#1E88E5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BaseTasks.ElapsedText}" FontSize="13"
                                       Foreground="#22303F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- 频段进度：顶部状态条显示"当前频段内"进度（切频段会归零重走）；
                             总进度（跨频段加权）在左侧「运行进度」里，鼠标悬停有说明 -->
                        <ProgressBar Width="170" Height="10" Margin="12,0,6,0" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Value="{Binding BaseTasks.BandProgress}"
                                     Foreground="#1E88E5" Background="#E3EBF3"
                                     ToolTip="当前频段内进度（总进度见左侧「运行进度」）"/>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#333333" MinWidth="40"
                                   ToolTip="{Binding BaseTasks.BandProgressText}">
                            <Run Text="{Binding BaseTasks.BandProgress, StringFormat={}{0:F0}}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== ② 图表模块区【按测试配置：显示哪些图由 ModuleProfileRegistry 决定】 ========== -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="6"
                    BorderBrush="#DCE8F2" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <ItemsControl x:Name="ChartItemsControl" ItemsSource="{Binding ActiveChartModules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 行/列数按启用的图表数量自适应（ViewModel.ChartRows / ChartColumns） -->
                            <UniformGrid Rows="{Binding ChartRows}" Columns="{Binding ChartColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <!-- 全部图表模块共用一个模板：标题/单位/是否对数由模块属性决定。
                             新增监测曲线只需在 ModuleCatalog + ModuleProfileRegistry 配置，不用改 XAML -->
                        <DataTemplate DataType="{x:Type modules:ChannelChartModule}">
                            <!-- 每张图白卡包裹，圆角细边框，与整体卡片风格一致 -->
                            <Border Background="White" CornerRadius="6" Margin="2"
                                    BorderBrush="#E3EBF3" BorderThickness="1">
                                <UseControls:UserChart
                                    ChartTitle="{Binding Title}"
                                    XAxisTitle="频率"
                                    YAxisTitle="{Binding YAxisTitle}"
                                    IsLogX="{Binding IsLogX}"
                                    YMinLimit="{Binding YMinLimit}"
                                    YMaxLimit="{Binding YMaxLimit}"
                                    XMinLimit="{Binding DataContext.MinFrequenceHz, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    XMaxLimit="{Binding DataContext.MaxFrequenceHz, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    ChartLines="{Binding Lines}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="ChartCoordinateClicked">
                                            <i:InvokeCommandAction Command="{Binding DataContext.Chart1ClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   PassEventArgsToCommand="True"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </UseControls:UserChart>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </Border>

            <!-- ========== ③ 底部按钮条：通用主按钮 + 按测试配置的附加按钮 ========== -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10,4" Margin="0,8,0,0"
                    BorderBrush="#DCE8F2" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 主控制按钮（所有测试通用，写死）。
                         状态互锁：按测试状态只放开有意义的按钮（CanXxx 由 VM 按 RunStateText 同步），
                         禁用态模板自动半透明——狂点无效也不再是"点了没反应" -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsEnableButtons}">
                        <Controls:StatusIconTextButton Label="{DynamicResource StartTestTitle}" IconSize="36" Margin="10,4,0,4"
                            Background="Transparent" Foreground="#1E88E5" IconKind="TimerStart"
                            IsEnabled="{Binding CanStartTest}"
                            Command="{Binding ModuleControlCommand}" CommandParameter="Ctl.Start"/>
                        <Controls:StatusIconTextButton Label="{DynamicResource StopTestTitle}" IconSize="36" Margin="10,4,0,4"
                            Background="Transparent" Foreground="#E53935" IconKind="Stop"
                            IsEnabled="{Binding CanStopTest}"
                            Command="{Binding ModuleControlCommand}" CommandParameter="Ctl.Stop"/>
                        <Controls:StatusIconTextButton Label="{Binding TestPauseLabel}" IconSize="36" Margin="10,4,0,4"
                            Background="Transparent" Foreground="#FB8C00" IconKind="{Binding TestPauseIcon}"
                            IsEnabled="{Binding CanPauseTest}"
                            Command="{Binding ModuleControlCommand}" CommandParameter="Ctl.Pause"/>
                        
                        <Controls:StatusIconTextButton Label="{DynamicResource SaveTitle}" IconSize="36" Margin="40,4,0,4"
                            Background="Transparent" Foreground="#AB47BC" IconKind="ContentSave"
                            IsEnabled="{Binding CanSaveData}"
                            Command="{Binding ModuleControlCommand}" CommandParameter="Ctl.Report"/>
                        <Controls:StatusIconTextButton Label="导出曲线图" IconSize="36" Margin="10,4,0,4"
                            Background="Transparent" Foreground="#00B3FF" IconKind="Image"
                            IsEnabled="{Binding IsEnableButtons}"
                            Command="{Binding ModuleControlCommand}" CommandParameter="Ctl.ExportCharts"/>
                        <Controls:StatusIconTextButton Label="导出报告" IconSize="36" Margin="10,4"
                            Background="Transparent" Foreground="#C300FF" IconKind="FileExport"
                            IsEnabled="{Binding IsEnableButtons}"
                            Command="{Binding ModuleControlCommand}" CommandParameter="Ctl.Report"/>
                    </StackPanel>

                    <!-- 运行状态灯 + 状态文字 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#B0BEC5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BaseTasks.RunStateText}" Value="测试中">
                                            <Setter Property="Fill" Value="#2ECC71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BaseTasks.RunStateText}" Value="准备中">
                                            <Setter Property="Fill" Value="#2ECC71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BaseTasks.RunStateText}" Value="已暂停">
                                            <Setter Property="Fill" Value="#FFA726"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BaseTasks.RunStateText}" Value="已完成">
                                            <Setter Property="Fill" Value="#2196F3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BaseTasks.RunStateText}" Value="已停止">
                                            <Setter Property="Fill" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding BaseTasks.RunStateText}" FontSize="20"
                                   Foreground="Gray" VerticalAlignment="Center" MinWidth="48" Width="70"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             左控制栏：频段设置 / 结果（摘要+动态表格） / 日志
             ============================================================ -->
        <TabControl TabStripPlacement="Left" BorderBrush="#FFCCCCCC" Margin="10,0,0,0">
            <!-- = 频段设置 + 运行进度 = -->
            <TabItem x:Name="tabItem1">
                <TabItem.Header>
                    <Controls:StatusIconTextButton Background="{x:Null}" IsHitTestVisible="False" Focusable="False"
                                                   Label="{DynamicResource RunInterfaceTitle}"
                                                   Foreground="{Binding IsSelected, Converter={StaticResource IsSelectedToForeColorConverter}, ElementName=tabItem1}"/>
                </TabItem.Header>
                <Grid Width="255" HorizontalAlignment="Center" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="频段设置" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.6*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="测试频段" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <ComboBox Grid.Column="1" Margin="0,6,5,0" Background="{x:Null}"
                                      ItemsSource="{Binding TitleBands}"
                                      SelectedIndex="{Binding SelBandIndex, Mode=TwoWay}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding ChooseBandCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="起始频率" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                            <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Background="{x:Null}" Foreground="Black" FontSize="20"
                                Value="{Binding MinFrequence, Mode=TwoWay}" BorderBrush="Gainsboro" Margin="0,8,5,0"/>
                            <TextBlock Grid.Row="2" Text="终止频率" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                            <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Background="{x:Null}" Foreground="Black" FontSize="20"
                                Value="{Binding MaxFrequence, Mode=TwoWay}" BorderBrush="Gainsboro" Margin="0,8,5,0"/>
                            <TextBlock Grid.Row="3" Text="切换模式" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,8,5,0" Background="{x:Null}"
                                      ItemsSource="{Binding BandSwitchMode}"
                                      DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                      SelectedValue="{Binding BandSwitchConfirmMode, Mode=TwoWay}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding BandSwitchActionCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <!-- 运行进度 -->
                    <GroupBox Grid.Row="1" Header="运行进度" Margin="0,10,0,6">                        <StackPanel>
                            <Grid Margin="0,4">
                                <TextBlock Text="运行状态" Style="{StaticResource ParamNameStyle}"/>
                                <TextBlock Text="{Binding BaseTasks.RunStateText}" Style="{StaticResource ParamValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="测试模式" Style="{StaticResource ParamNameStyle}"/>
                                <TextBlock Text="{Binding BaseTasks.RunModeText}" Style="{StaticResource ParamValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="当前频点" Style="{StaticResource ParamNameStyle}"/>
                                <TextBlock Text="{Binding BaseTasks.CurrentFrequencyText}" Style="{StaticResource ParamValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="经过时间" Style="{StaticResource ParamNameStyle}"/>
                                <TextBlock Text="{Binding BaseTasks.ElapsedText}" Style="{StaticResource ParamValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="在线设备" Style="{StaticResource ParamNameStyle}"/>
                                <TextBlock Text="{Binding BaseTasks.OnLineCount}" Style="{StaticResource ParamValueStyle}"/>
                            </Grid>
                            <TextBlock Text="总进度" Margin="0,10,0,4" FontSize="12" Foreground="#6B7A8D"/>
                            <ProgressBar Height="14" Minimum="0" Maximum="100"
                                         Value="{Binding BaseTasks.TestProgress}"
                                         Foreground="#1E88E5" Background="#E3EBF3"/>
                            <TextBlock Text="{Binding BaseTasks.TestProgress, StringFormat={}{0:F1} %}"
                                       HorizontalAlignment="Right" FontSize="12" Foreground="#333333" Margin="0,2,0,0"/>
                            <!-- 频段上下文：总进度是跨频段的整体进度（分频段只是功放频率范围不够），
                                 这行补上"当前第几段 / 段内进度"，避免只看总进度时误判"卡住了" -->
                            <TextBlock Text="{Binding BaseTasks.BandProgressText}" FontSize="12"
                                       Foreground="#6B7A8D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 运行日志：连接信息 / 测试动作 / 异常告警实时上屏（与"日志"页同源 BaseTasks.LogItems），
                         新日志自动滚动到底；上限 200 条由 BaseRunTask.AddLog 维护 -->
                    <GroupBox Grid.Row="2" Header="运行日志" Margin="0,0,0,6" Padding="0,4">
                        <ListBox x:Name="RunLogList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding BaseTasks.LogItems}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Foreground="Gray" Width="62" FontSize="11"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{Binding LevelColor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- = 结果 = -->
            <TabItem x:Name="tabItem2">
                <TabItem.Header>
                    <Controls:StatusIconTextButton Background="{x:Null}" IsHitTestVisible="False" Focusable="False"
                                       Label="{DynamicResource ResultInterfaceTitle}"
                                       Foreground="{Binding IsSelected, Converter={StaticResource IsSelectedToForeColorConverter}, ElementName=tabItem2}"/>
                </TabItem.Header>
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 结果判定摘要（通用）：总判定徽章 + 三个统计胶囊 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource CardAccentBar}" Height="18"/>
                                <TextBlock Text="判定摘要" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 总判定徽章 -->
                                <Border Grid.Column="0" CornerRadius="8" Padding="18,10" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ECEFF1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BaseTasks.ResultVerdict}" Value="合格">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BaseTasks.ResultVerdict}" Value="不合格">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding BaseTasks.ResultVerdict}"
                                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#78909C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BaseTasks.ResultVerdict}" Value="合格">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BaseTasks.ResultVerdict}" Value="不合格">
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="总判定" FontSize="11" Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 统计胶囊：总点数 / 超标点 / 最大余量 -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatChipBorder}" Background="#E3F2FD">
                                        <Grid Width="150">
                                            <TextBlock Text="总点数" Style="{StaticResource ParamNameStyle}"/>
                                            <TextBlock Text="{Binding BaseTasks.TotalPoints}" Style="{StaticResource ParamValueStyle}"
                                                       Foreground="#1565C0"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource StatChipBorder}" Background="#FFEBEE">
                                        <Grid Width="150">
                                            <TextBlock Text="超标点" Style="{StaticResource ParamNameStyle}"/>
                                            <TextBlock Text="{Binding BaseTasks.OverLimitCount}" Style="{StaticResource ParamValueStyle}"
                                                       Foreground="#D32F2F"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource StatChipBorder}" Background="#FFF8E1">
                                        <Grid Width="150">
                                            <TextBlock Text="最大余量" Style="{StaticResource ParamNameStyle}"/>
                                            <TextBlock Text="{Binding BaseTasks.WorstMargin}" Style="{StaticResource ParamValueStyle}"
                                                       Foreground="#F57C00"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 结果表 / 校验比对表【按测试配置：列头由 ModuleCatalog 决定，行由 RunTask 提供】 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveTables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource CardAccentBar}"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}"/>
                                            </StackPanel>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                                                <StackPanel>
                                                    <!-- 表头（深蓝渐变 + 白字） -->
                                                    <Border CornerRadius="4" BorderBrush="#1F4E79" BorderThickness="0,0,0,2">
                                                        <Border.Background>
                                                            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                                                                <GradientStop Color="#2B6CB0"/>
                                                                <GradientStop Color="#1F4E79" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="序号" Style="{StaticResource TableHeaderCellStyle}" Width="40"/>
                                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Style="{StaticResource TableHeaderCellStyle}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 数据行（超标标红 / 临界标黄 / 悬停高亮） -->
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="rowBorder" Background="Transparent"
                                                                        BorderBrush="#EDF2F7" BorderThickness="0,0,0,1">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="noCell" Text="{Binding No}"
                                                                                   Style="{StaticResource TableCellStyle}" Width="40"/>
                                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding}" Style="{StaticResource TableCellStyle}"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                                        <Setter TargetName="rowBorder" Property="Background" Value="#FDECEA"/>
                                                                        <Setter TargetName="noCell" Property="Foreground" Value="#D32F2F"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                        <Setter TargetName="rowBorder" Property="Background" Value="#FFF8E1"/>
                                                                        <Setter TargetName="noCell" Property="Foreground" Value="#F57C00"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                                                        <Setter TargetName="rowBorder" Property="Background" Value="#F0F7FF"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- 空表占位：提示数据来源（结果表由 RunTask 填充） -->
                                                    <TextBlock Text="暂无数据（由测试任务生成）" FontSize="12" Foreground="#B0BEC5"
                                                               HorizontalAlignment="Center" Margin="0,10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- = 日志（原有） = -->
            <TabItem x:Name="tabItem3">
                <TabItem.Header>
                    <Controls:StatusIconTextButton Background="{x:Null}" IsHitTestVisible="False" Focusable="False"
                           Label="{DynamicResource TestLogTitle}"
                           Foreground="{Binding IsSelected, Converter={StaticResource IsSelectedToForeColorConverter}, ElementName=tabItem3}"/>
                </TabItem.Header>
                <Grid Width="255" HorizontalAlignment="Center" Background="Transparent">
                    <DockPanel Margin="0">
                        <Controls:StatusIconTextButton DockPanel.Dock="Bottom" Height="40" Label="清空" IconSize="35" Margin="0"
                           Background="#02BB9E9E" Foreground="#FF614D43" IconKind="Delete"
                           Command="{Binding ClearLogMessageCommand}" />
                        <ListBox ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ItemsSource="{Binding BaseTasks.LogItems}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Foreground="Gray" Width="70"/>
                                        <TextBlock Text="{Binding Level}" Width="55" Foreground="{Binding LevelColor}"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================================================
             右侧面板：测试信息（通用） + 参数卡模块区【按测试配置】
             ============================================================ -->
        <Grid Grid.Column="2" Margin="6,0,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 测试信息（通用，所有测试都一样） -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,6,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource CardAccentBar}"/>
                        <TextBlock Text="测试信息" Style="{StaticResource CardTitleStyle}"/>
                    </StackPanel>
                    <ListView ItemsSource="{Binding DisplayInfo}" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ParamNameStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ParamValueStyle}"
                                               MaxWidth="170"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 参数卡模块区【按测试配置：显示哪些卡由 ModuleProfileRegistry 决定，
                 卡片数据由 RunTask 的 IPanelDataProvider 提供】 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ActiveCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource CardAccentBar}"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ParamNameStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ParamValueStyle}"
                                                               MaxWidth="170"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
