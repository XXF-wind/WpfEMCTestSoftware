<Page x:Class="WpfEMCTestSoftware.Views.LimitConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views"
      xmlns:Models="clr-namespace:WpfEMCTestSoftware.Models"
      xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls" 
      DataContext="{Binding LimitConfigViewModel, Source={StaticResource Locator}}"
      mc:Ignorable="d" FontSize="24"
      d:DesignHeight="910" d:DesignWidth="1840"
      Title="LimitConfigPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <TreeView  Grid.Row="1" ItemsSource="{Binding TreeItems}" SelectedItemChanged="TreeView_SelectedItemChanged"
        SelectedValuePath="Name"
        FontFamily="Microsoft YaHei" FontSize="26">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type Models:TreeItem}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Height="40">
                        <Controls:StatusIconTextButton IconKind="{Binding IconKind}" Foreground="{Binding IconForeground}" Label="" Margin="0" Background="{x:Null}"/>
                        <Label Content="{Binding Name}" HorizontalContentAlignment="Center" 
                        VerticalContentAlignment="Center" FontSize="26" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <Grid Grid.Column="1" Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0"  FontSize="16"  AutoGenerateColumns="True" IsReadOnly="False"  CanUserAddRows="True"  CanUserDeleteRows="True"
            BorderBrush="#E0E0E0"  BorderThickness="1" Margin="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"   HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
            ItemsSource="{Binding CsvDataTable.DefaultView}" />
            <!--<lvc:CartesianChart Grid.Column="1" Margin="0,0,5,0" ScrollMode="XY" LegendLocation="Top">
                <lvc:CartesianChart.Series>
                    <lvc:LineSeries Values="{Binding ListValue}" Title="{Binding ValueLabel}"/>
                </lvc:CartesianChart.Series>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis x:Name="s1y" Title="{Binding YTitle}"  Foreground="White" FontSize="18" />
                </lvc:CartesianChart.AxisY>
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis x:Name="s1x" Title="{Binding XTitie}" 
              ShowLabels="True" Foreground="White" FontSize="18" 
               />
                </lvc:CartesianChart.AxisX>
            </lvc:CartesianChart>-->
        </Grid>
        
        <Controls:StatusIconTextButton Content="StatusIconTextButton" HorizontalAlignment="Left" 
                                 Height="58" Margin="12,11,0,0" VerticalAlignment="Top" Width="123"
                                 IconSize="50" FontSize="26" Background="#19DDDDDD" Foreground="#FF3394FF"
                                 Label="{DynamicResource AddTitle}" IconKind="PlusBoxMultipleOutline"
                                       
                                 Command="{Binding AddTableCommand}" CommandParameter="0"/>

        <Controls:StatusIconTextButton Content="StatusIconTextButton" HorizontalAlignment="Left" 
                          Height="58" VerticalAlignment="Center" Width="123" Margin="154,11,0,0"
                          IconSize="50" FontSize="26" Background="#19DDDDDD" Foreground="#FFFF3333"
                          Label="{DynamicResource DelTitle}" IconKind="TrashCanOutline"
                          Command="{Binding DeleteTableCommand}" CommandParameter="2" />
        <Controls:StatusIconTextButton Content="StatusIconTextButton" HorizontalAlignment="Left"
                                 Height="58" Margin="298,2,0,0" VerticalAlignment="Top" Width="142"
                                 IconSize="58" FontSize="24" Background="#19DDDDDD" Foreground="#FFFF3333"
                                 Label="{DynamicResource ExitTitle}" IconKind="ExitToApp"
                                 Command="{Binding CencelCommand}" CommandParameter="4" Grid.Column="1"/>

        <Controls:StatusIconTextButton Content="StatusIconTextButton" 
            Height="58" VerticalAlignment="Center"
            IconSize="48" FontSize="28" Background="#19DDDDDD" Foreground="#FF3394FF"
            Label="{DynamicResource SaveTitle}" IconKind="ContentSaveAll"
            Command="{Binding ConfirmCommand}" CommandParameter="3" HorizontalAlignment="Left" Width="142" Grid.Column="1" Margin="4,0,0,0"/>
        <Controls:StatusIconTextButton Content="StatusIconTextButton" 
           Height="58" VerticalAlignment="Center"
           IconSize="48" FontSize="28" Background="#19DDDDDD" Foreground="#FF3394FF"
           Label="{DynamicResource SaveASConfigTitle}" IconKind="ContentSaveAdd"
           Command="{Binding SaveASCommand}" CommandParameter="3" HorizontalAlignment="Left" Width="142" Grid.Column="1" Margin="150,0,0,0"/>
    </Grid>
</Page>
