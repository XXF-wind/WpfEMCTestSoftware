                            <Controls:ArrowSeparator.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="-47.863"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Controls:ArrowSeparator.RenderTransform>
