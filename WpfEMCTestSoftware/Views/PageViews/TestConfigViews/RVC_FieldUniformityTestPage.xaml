                        <RadioButton Content="6" Margin="222,150,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" 
                          Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[5], Converter={StaticResource ChannelStatusToBrushConverter}}"
                          IsChecked="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.TestContext.CurPosition,Mode=OneWay,
                          Converter={StaticResource ValueToBoolConverter},ConverterParameter=6}"/>
                        <RadioButton Content="7" Margin="222,39,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" 
