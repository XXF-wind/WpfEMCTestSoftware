                        <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="103,44,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="130" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
