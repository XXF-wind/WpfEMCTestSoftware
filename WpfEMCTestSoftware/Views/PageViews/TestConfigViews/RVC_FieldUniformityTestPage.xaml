                            <UIControlClass:DashLine.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="90"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </UIControlClass:DashLine.RenderTransform>
                        </UIControlClass:DashLine>
                        <RadioButton Margin="21,228,0,0" Content="1" 
                            Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[0], Converter={StaticResource ChannelStatusToBrushConverter}}"
                            IsChecked="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.TestContext.CurPosition,Mode=OneWay,
                            Converter={StaticResource ValueToBoolConverter}, ConverterParameter=1}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                       <RadioButton Margin="152,228,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="2" 
                            Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[1], Converter={StaticResource ChannelStatusToBrushConverter}}"
                            IsChecked="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.TestContext.CurPosition,Mode=OneWay,
                            Converter={StaticResource ValueToBoolConverter},ConverterParameter=2}"/>
                        <RadioButton  Margin="152,118,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="3" 
                            Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[2], Converter={StaticResource ChannelStatusToBrushConverter}}"
                            IsChecked="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.TestContext.CurPosition,Mode=OneWay,
                            Converter={StaticResource ValueToBoolConverter},ConverterParameter=3}"/>
                        <RadioButton Margin="21,118,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="4"
                          Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[3], Converter={StaticResource ChannelStatusToBrushConverter}}"
                          IsChecked="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.TestContext.CurPosition,Mode=OneWay,
                          Converter={StaticResource ValueToBoolConverter},ConverterParameter=4}"/>
                        <RadioButton Margin="96,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="5" 
                          Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[4], Converter={StaticResource ChannelStatusToBrushConverter}}"
                          IsChecked="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.TestContext.CurPosition,Mode=OneWay,
