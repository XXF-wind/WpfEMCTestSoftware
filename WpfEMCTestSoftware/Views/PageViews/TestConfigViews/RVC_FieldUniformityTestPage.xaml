                        <RadioButton Margin="93,39,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Content="8" 
                           Background="{Binding RVC_FieldUniformityTestViewModel.BaseTasks.ChannelStates[7], Converter={StaticResource ChannelStatusToBrushConverter}}"
