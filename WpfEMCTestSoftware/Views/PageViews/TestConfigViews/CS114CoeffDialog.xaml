<Window x:Class="WpfEMCTestSoftware.Views.PageViews.TestConfigViews.CS114CoeffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
        xmlns:testmodels="clr-namespace:WpfEMCTestSoftware.Models.TestModels"
        mc:Ignorable="d"
        Title="系数设置" Height="600" Width="780" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{x:Null}" AllowsTransparency="True"
        
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewTextInput="Window_PreviewTextInput" PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            Background="{DynamicResource CardBackgroundBrush}" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Border Width="5" Height="20" CornerRadius="2"
                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="系数设置" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding LinkDisplayName}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="链路损耗系数（频率 → dB）。支持手动添加或从文件导入，添加完可导出备份，保存后下次使用自动加载。"
                           FontSize="13" Margin="15,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 状态徽标行 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                <TextBlock Text="当前状态：" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border CornerRadius="10" Padding="12,3" Margin="4,0,0,0"
                        Background="{DynamicResource AccentLightBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPoints}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextOnAccentBrush}"/>
                </Border>
                <TextBlock Text="{Binding PointCountInfo}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 系数表格 -->
            <DataGrid Grid.Row="2" Margin="0,6,0,0"
                      ItemsSource="{Binding CoeffPoints}"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AutoGenerateColumns="False" CanUserReorderColumns="False"
                      SelectionMode="Single"
                      Background="Transparent" RowHeight="34"
                      BorderBrush="{DynamicResource BorderBrush}" FontSize="14"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="频率 (MHz)" Binding="{Binding FreqMHz, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="系数 (dB)" Binding="{Binding CoefDB, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 按钮区 -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Controls:RoundedButton Content="添加行" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                            Command="{Binding AddRowCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="删除行" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonDangerBgBrush}" Foreground="{DynamicResource ButtonDangerFgBrush}"
                                            Command="{Binding DeleteRowCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="导入" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Command="{Binding ImportCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="导出" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Command="{Binding ExportCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="清除" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Command="{Binding ClearCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Controls:RoundedButton Content="取 消" Width="100" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Click="BtnCancel_Click" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="保 存" Width="100" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
