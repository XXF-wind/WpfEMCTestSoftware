<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views.PageViews.TestConfigViews" 
      xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
      xmlns:UseControls="clr-namespace:Company.UI.Controls.UseControls;assembly=Company.UI.Controls"
      xmlns:UIControlClass="clr-namespace:Company.UI.Controls.UIControlClass;assembly=Company.UI.Controls"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"   
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"   
      x:Class="WpfEMCTestSoftware.Views.PageViews.TestConfigViews.RVC_FieldUniformityConfigAnalysis"     
      mc:Ignorable="d" 
      d:DesignHeight="893" d:DesignWidth="1840"    
      DataContext="{Binding RVC_FieldUniformityAnalysisViewModel,Source={StaticResource Locator}}"
      Title="RVC_FieldUniformityConfigAnalysis"
      Background="{DynamicResource PageBackgroundBrush}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding FirstLoadPageCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ 左栏：控制面板 ═══════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">

                <!-- 导入数据源 -->
                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelHeaderBgBrush}" 
                                CornerRadius="6,6,0,0" Margin="-10,-10,-10,8">
                            <TextBlock Text="导入数据源" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource PanelHeaderFgBrush}"
                                       Padding="8,5"/>
                        </Border>
                        <ComboBox Height="28"
                                  ItemsSource="{Binding FieldUniformityAnalysisValues}"
                                  SelectedItem="{Binding FieldUniformityAnalysisTestName}"
                                  Background="{DynamicResource InputBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource InputBorderBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 基本信息 -->
                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelHeaderBgBrush}" 
                                CornerRadius="6,6,0,0" Margin="-10,-10,-10,8">
                            <TextBlock Text="基本信息" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource PanelHeaderFgBrush}"
                                       Padding="8,5"/>
                        </Border>
                        <TextBlock Text="分析标准：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,2" FontSize="11"/>
                        <TextBox Height="26" Margin="0,0,0,6"
                                 Text="{Binding AnalysisStandard}"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Text="测试位置：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,2" FontSize="11"/>
                        <TextBox Height="26" Margin="0,0,0,6"
                                 Text="{Binding TestPositionCounts}"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Text="频率范围：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,2" FontSize="11"/>
                        <TextBox Height="26"
                                 Text="{Binding FreRange}"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Q及时间常数 -->
                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelHeaderBgBrush}" 
                                CornerRadius="6,6,0,0" Margin="-10,-10,-10,8">
                            <TextBlock Text="Q 及时间常数计算" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource PanelHeaderFgBrush}"
                                       Padding="8,5"/>
                        </Border>

                        <TextBlock Text="混响室容积：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,2" FontSize="11"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="m³" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
                            <mah:NumericUpDown Width="100" Height="26"
                                               Value="{Binding ChamberVolume_V,Mode=TwoWay}"
                                               Background="{DynamicResource InputBackgroundBrush}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <TextBlock Text="发射天线效率：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,2" FontSize="11"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="%" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
                            <mah:NumericUpDown Width="100" Height="26"
                                               Value="{Binding EtaT2,Mode=TwoWay}"
                                               Background="{DynamicResource InputBackgroundBrush}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <TextBlock Text="接收天线效率：" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,2" FontSize="11"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="%" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
                            <mah:NumericUpDown Width="100" Height="26"
                                               Value="{Binding EtaR6,Mode=TwoWay}"
                                               Background="{DynamicResource InputBackgroundBrush}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6"/>

                        <DockPanel Margin="0,3,0,3">
                            <TextBox DockPanel.Dock="Right" Width="70" Height="24"
                                     Text="{Binding CurItem.QValue}"
                                     Background="{DynamicResource AccentLightBrush}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     FontWeight="Bold" TextAlignment="Center"
                                     VerticalContentAlignment="Center" IsReadOnly="True"/>
                            <TextBlock Text="品质因数 Q：" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </DockPanel>

                        <DockPanel Margin="0,3,0,0">
                            <TextBox DockPanel.Dock="Right" Width="70" Height="24"
                                     Text="{Binding CurItem.Tau_us}"
                                     Background="{DynamicResource AccentLightBrush}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     FontWeight="Bold" TextAlignment="Center"
                                     VerticalContentAlignment="Center" IsReadOnly="True"/>
                            <TextBlock Text="时间常数 τ：" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 图形操作 -->
                <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelHeaderBgBrush}" 
                                CornerRadius="6,6,0,0" Margin="-10,-10,-10,8">
                            <TextBlock Text="图形操作" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource PanelHeaderFgBrush}"
                                       Padding="8,5"/>
                        </Border>
                        <DockPanel Margin="0,3,0,6">
                            <Button DockPanel.Dock="Right" Width="95" Height="26"
                                    Content="图形一键反色"
                                    Background="{DynamicResource ButtonSecondaryBgBrush}"
                                    Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" FontSize="11"/>
                            <TextBlock Text="图形背景" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </DockPanel>
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="115" Height="26"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}"/>
                            <TextBlock Text="AVF/CVF 模式" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <Border Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelHeaderBgBrush}" 
                                CornerRadius="6,6,0,0" Margin="-10,-10,-10,8">
                            <TextBlock Text="操作" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource PanelHeaderFgBrush}"
                                       Padding="8,5"/>
                        </Border>
                        <Button Height="32" Margin="0,0,0,6"
                                Content="▶  开始分析"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource TextOnAccentBrush}"
                                BorderThickness="0" FontWeight="Bold" FontSize="13"
                                Command="{Binding AnalysisDataCommand}"/>
                        <Button Height="32" Margin="0,0,0,6"
                                Content="⬇  导出数据"
                                Background="{DynamicResource ButtonSecondaryBgBrush}"
                                Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                FontSize="12"
                                Command="{Binding ExportDataCommand}"/>
                        <Button Height="32"
                                Content="✕  退出"
                                Background="{DynamicResource ButtonDangerBgBrush}"
                                Foreground="{DynamicResource ButtonDangerFgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                FontSize="12"
                                Command="{Binding ExitCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 中栏：图表区 ═══════════════ -->
        <Grid Grid.Column="1" Margin="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 3D 坐标图 -->
            <Border Margin="0,0,0,4" Padding="10" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- 图例说明（右侧） -->
                    <StackPanel DockPanel.Dock="Right" Width="200" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="测试点位分布 · 3D 坐标图" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10">
                            混响室测试区域以 3D 立方体建模，
                            9 个测试点均匀分布于空间角点、边中点和体中心位置。
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#8B5CF6" Margin="0,0,6,0"/>
                            <TextBlock Text="角点 1-4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" Margin="0,0,6,0"/>
                            <TextBlock Text="边中点 5-8" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#22C55E" Margin="0,0,6,0"/>
                            <TextBlock Text="体中心 9" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 立方体图 -->
                    <Border Padding="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
                        <Viewbox>
                            <Grid Height="300" Width="300">
                                <!-- 底面 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="44,226,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="110" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.5"/>
                                <!-- 顶面后边 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="44,124,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="110" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.7"/>
                                <!-- 左棱 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="4,158,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="90" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.6">
                                    <Controls:ArrowSeparator.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="90"/><TranslateTransform/></TransformGroup>
                                    </Controls:ArrowSeparator.RenderTransform>
                                </Controls:ArrowSeparator>
                                <!-- 右棱 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="108,158,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="90" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.8">
                                    <Controls:ArrowSeparator.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="90"/><TranslateTransform/></TransformGroup>
                                    </Controls:ArrowSeparator.RenderTransform>
                                </Controls:ArrowSeparator>
                                <!-- 左斜边 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="22,90,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="90" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.5">
                                    <Controls:ArrowSeparator.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="-47"/><TranslateTransform/></TransformGroup>
                                    </Controls:ArrowSeparator.RenderTransform>
                                </Controls:ArrowSeparator>
                                <!-- 右斜边 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="128,90,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="90" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.5">
                                    <Controls:ArrowSeparator.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="-47"/><TranslateTransform/></TransformGroup>
                                    </Controls:ArrowSeparator.RenderTransform>
                                </Controls:ArrowSeparator>
                                <!-- 顶面前边 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="92,42,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="110" ShowEndArrow="False" ShowStartArrow="False"/>
                                <!-- 右后棱 -->
                                <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="160,80,0,0" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Height="8" Width="90" ShowEndArrow="False" ShowStartArrow="False" Opacity="0.6">
                                    <Controls:ArrowSeparator.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="90"/><TranslateTransform/></TransformGroup>
                                    </Controls:ArrowSeparator.RenderTransform>
                                </Controls:ArrowSeparator>

                                <!-- 虚线 -->
                                <UIControlClass:DashLine HorizontalAlignment="Left" Height="12" Margin="20,180,0,0" VerticalAlignment="Top" Width="90" Opacity="0.4">
                                    <UIControlClass:DashLine.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="-47"/><TranslateTransform/></TransformGroup>
                                    </UIControlClass:DashLine.RenderTransform>
                                </UIControlClass:DashLine>
                                <UIControlClass:DashLine HorizontalAlignment="Left" Height="6" Margin="92,148,0,0" VerticalAlignment="Top" Width="110" Opacity="0.4"/>
                                <UIControlClass:DashLine HorizontalAlignment="Left" Height="16" Margin="52,100,0,0" VerticalAlignment="Top" Width="90" Opacity="0.4">
                                    <UIControlClass:DashLine.RenderTransform>
                                        <TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform Angle="90"/><TranslateTransform/></TransformGroup>
                                    </UIControlClass:DashLine.RenderTransform>
                                </UIControlClass:DashLine>

                                <!-- 测试点 RadioButton 1-9 -->
                                <RadioButton Margin="24,212,0,0" Content="1" 
                                             Background="{Binding ChannelStates[0], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=1, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="136,212,0,0" Content="2"
                                             Background="{Binding ChannelStates[1], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=2, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="136,110,0,0" Content="3"
                                             Background="{Binding ChannelStates[2], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=3, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="24,110,0,0" Content="4"
                                             Background="{Binding ChannelStates[3], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=4, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="86,142,0,0" Content="5"
                                             Background="{Binding ChannelStates[4], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=5, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="196,142,0,0" Content="6"
                                             Background="{Binding ChannelStates[5], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=6, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="196,44,0,0" Content="7"
                                             Background="{Binding ChannelStates[6], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=7, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="86,44,0,0" Content="8"
                                             Background="{Binding ChannelStates[7], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=8, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>
                                <RadioButton Margin="94,156,0,0" Content="9"
                                             Background="{Binding ChannelStates[8], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                             IsChecked="{Binding CurrentPoint, ConverterParameter=9, Converter={StaticResource ValueToBoolConverter}, Mode=OneWay}" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"/>

                                <!-- 坐标轴 -->
                                <TextBlock Text="X" Foreground="#EF4444" FontSize="12" FontWeight="Bold" Margin="155,225,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="Y" Foreground="#22C55E" FontSize="12" FontWeight="Bold" Margin="14,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="Z" Foreground="#3B82F6" FontSize="12" FontWeight="Bold" Margin="205,120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 6 图表网格 -->
            <UniformGrid Grid.Row="1" Rows="3" Columns="2" Margin="0,4,0,0" Background="{x:Null}">
                <UseControls:UserChart ChartTitle="均匀性分析图形" XAxisTitle="频率" YAxisTitle="标准偏差(dB)"
                    XMinLimit="{Binding MinFre}" XMaxLimit="{Binding MaxFre}"
                    ChartLines="{Binding SigmaChartLine}"
                    Background="{x:Null}" Foreground="{DynamicResource ChartAxesBrush}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ChartCoordinateClicked">
                            <i:InvokeCommandAction Command="{Binding Chart1ClickCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </UseControls:UserChart>
                <UseControls:UserChart ChartTitle="AVF/ACF测试数据" XAxisTitle="频率" YAxisTitle="AVF/ACF"
                    XMinLimit="{Binding MinFre}" XMaxLimit="{Binding MaxFre}"
                    ChartLines="{Binding AcfChartLine}"
                    Background="{x:Null}" Foreground="{DynamicResource ChartAxesBrush}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ChartCoordinateClicked">
                            <i:InvokeCommandAction Command="{Binding Chart1ClickCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </UseControls:UserChart>
                <UseControls:UserChart ChartTitle="Q测试数据" XAxisTitle="频率" YAxisTitle="Q"
                    XMinLimit="{Binding MinFre}" XMaxLimit="{Binding MaxFre}"
                    ChartLines="{Binding QChartLine}"
                    Background="{x:Null}" Foreground="{DynamicResource ChartAxesBrush}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ChartCoordinateClicked">
                            <i:InvokeCommandAction Command="{Binding Chart1ClickCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </UseControls:UserChart>
                <UseControls:UserChart ChartTitle="T测试数据" XAxisTitle="频率" YAxisTitle="T"
                    XMinLimit="{Binding MinFre}" XMaxLimit="{Binding MaxFre}"
                    ChartLines="{Binding TChartLine}"
                    Background="{x:Null}" Foreground="{DynamicResource ChartAxesBrush}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ChartCoordinateClicked">
                            <i:InvokeCommandAction Command="{Binding Chart1ClickCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </UseControls:UserChart>
                <UseControls:UserChart ChartTitle="归一化场强均值数据" XAxisTitle="频率" YAxisTitle="E"
                    XMinLimit="{Binding MinFre}" XMaxLimit="{Binding MaxFre}"
                    ChartLines="{Binding EAvgChartLine}"
                    Background="{x:Null}" Foreground="{DynamicResource ChartAxesBrush}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ChartCoordinateClicked">
                            <i:InvokeCommandAction Command="{Binding Chart1ClickCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </UseControls:UserChart>
                <UseControls:UserChart ChartTitle="插损L测试数据" XAxisTitle="频率" YAxisTitle="L"
                    XMinLimit="{Binding MinFre}" XMaxLimit="{Binding MaxFre}"
                    ChartLines="{Binding ILChartLine}"
                    Background="{x:Null}" Foreground="{DynamicResource ChartAxesBrush}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ChartCoordinateClicked">
                            <i:InvokeCommandAction Command="{Binding Chart1ClickCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </UseControls:UserChart>
            </UniformGrid>

            <!-- 底部进度条 -->
            <Border Grid.Row="2" Margin="0,4,0,0" Padding="8,4" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Controls:StatusIconTextButton DockPanel.Dock="Right"
                        Content="StatusIconTextButton" IconSize="36" FontSize="18"
                        Foreground="{DynamicResource AccentBrush}"
                        IconKind="{Binding ResultIcon}" Label="{Binding ResultLabel}"
                        Background="{x:Null}" Height="40" Width="110"/>
                    <ProgressBar Height="20" Margin="0,0,8,0"
                                 Value="{Binding AnalysisProgress}" IsIndeterminate="False"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SurfaceAltBrush}"/>
                </DockPanel>
            </Border>
        </Grid>

                <!-- ═══════════════ 右栏：基本信息参数 ═══════════════ -->
        <Border Grid.Column="2" Margin="6,0,0,0" Padding="10" CornerRadius="6"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource PanelHeaderBgBrush}" 
                            CornerRadius="6,6,0,0" Margin="-10,-10,-10,8">
                        <TextBlock Text="基本信息" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource PanelHeaderFgBrush}" Padding="10,5"/>
                    </Border>

                    <!-- 参数表：Grid 三列对齐 -->
                    <Grid Margin="0,4,0,0">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/>
                            <RowDefinition Height="28"/><RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="场强限值" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="70" Text="{Binding CurItem.LimitE}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="V/m" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分析频点" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="70" Text="{Binding CurItem.Frequency}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="MHz" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ACF" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="70" Text="{Binding CurItem.ACF}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="插入损耗IL" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="70" Text="{Binding CurItem.InsertionLoss_dB}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="V/m" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>

                        <Border Grid.Row="4" Grid.ColumnSpan="3" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ex归一化均值" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Width="70" Text="{Binding CurItem.ExAvg}"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="(V/m)/√W" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" FontSize="10"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Ex标准偏差" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Width="70" Text="{Binding CurItem.SigmaX_dB}"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="dB" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Ey归一化均值" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Width="70" Text="{Binding CurItem.EyAvg}"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="(V/m)/√W" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" FontSize="10"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Ey标准偏差" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Width="70" Text="{Binding CurItem.SigmaY_dB}"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="dB" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Ez归一化均值" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Width="70" Text="{Binding CurItem.EzAvg}"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="(V/m)/√W" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" FontSize="10"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Ez标准偏差" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Width="70" Text="{Binding CurItem.SigmaZ_dB}"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="dB" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Ec归一化均值" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Width="70" Text="{Binding CurItem.EcAvg}"/>
                        <TextBlock Grid.Row="11" Grid.Column="2" Text="(V/m)/√W" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0" FontSize="10"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Ec标准偏差" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Width="70" Text="{Binding CurItem.SigmaGlobal_dB}"/>
                        <TextBlock Grid.Row="12" Grid.Column="2" Text="dB" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,10"/>

                    <Border CornerRadius="6" Padding="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="频点均匀性结论" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" FontSize="12" Margin="0,0,0,6"/>
                            <Border CornerRadius="4" Padding="6" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding CurItem.IsPass}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="16" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Slider Maximum="100" Minimum="0" Margin="0,10,0,0" TickFrequency="1" TickPlacement="BottomRight" Value="40" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceAltBrush}" Height="28"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
