<Window x:Class="WpfEMCTestSoftware.Views.PageViews.TestConfigViews.CS114AddressScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
        mc:Ignorable="d"
        Title="仪器通讯地址" Height="560" Width="760" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{x:Null}" AllowsTransparency="True"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            Background="{DynamicResource CardBackgroundBrush}" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Orientation="Horizontal">
                <Border Width="5" Height="20" CornerRadius="2"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="仪器通讯地址 —" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding SlotRoleName}" FontSize="20" FontWeight="Bold" Margin="6,0,0,0"
                           Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>

            <!-- 获取方式 -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="获取方式：" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <RadioButton Content="自动扫描" IsChecked="True" FontSize="14" Margin="10,0,0,0"
                                 GroupName="AddrMode" Checked="ModeRadio_Checked"/>
                    <RadioButton Content="手动输入" FontSize="14" Margin="20,0,0,0"
                                 GroupName="AddrMode" Checked="ModeRadio_Checked"/>
                </StackPanel>
                <TextBlock FontSize="12" Margin="10,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="自动获取：选中通讯地址扫描 → 点击扫描，软件自动获取在线仪器型号与地址 → 选中通讯地址点击应用 → 确定，即可完成设置。"/>
            </StackPanel>

            <!-- 自动扫描结果 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Controls:RoundedButton Content="扫描" Width="90" Height="32" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                            Command="{Binding ScanCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="应用" Width="90" Height="32" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Command="{Binding ApplyCommand}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ScanHint}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <DataGrid Grid.Row="1" Margin="0,8,0,0"
                          ItemsSource="{Binding ScanResults}"
                          SelectedItem="{Binding CurScanItem, Mode=TwoWay}"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          AutoGenerateColumns="False" CanUserReorderColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          Background="Transparent" RowHeight="32" FontSize="14"
                          BorderBrush="{DynamicResource BorderBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="通讯方式" Binding="{Binding Comm}" Width="*"/>
                        <DataGridTextColumn Header="通讯地址" Binding="{Binding Address}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 手动输入 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="通讯地址：" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Width="220" Height="32" FontSize="14" VerticalContentAlignment="Center"
                         Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"/>
                <Controls:RoundedButton Content="应用" Width="90" Height="32" FontSize="15" CornerRadius="6"
                                        Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                        Command="{Binding ApplyManualCommand}" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding AppliedInfo}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Controls:RoundedButton Content="取 消" Width="100" Height="34" FontSize="15" CornerRadius="6"
                                        Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Controls:RoundedButton Content="确 定" Width="100" Height="34" FontSize="15" CornerRadius="6"
                                        Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                        Click="BtnOK_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
