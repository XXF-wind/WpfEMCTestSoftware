<Window x:Class="WpfEMCTestSoftware.Views.PageViews.TestConfigViews.CS114LimitImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="限值数据导入" Height="640" Width="800" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{x:Null}" AllowsTransparency="True"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewTextInput="Window_PreviewTextInput" PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            Background="{DynamicResource CardBackgroundBrush}" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Border Width="5" Height="20" CornerRadius="2"
                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="限值数据导入" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding BandInfo}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock FontSize="13" Margin="15,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="导入传导安全裕度测试数据，加上偏置（默认 +6dB，可自行修改）生成本频段限值曲线；也可以直接手动添加限值点。"/>
            </StackPanel>

            <!-- 导入与偏置 -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="裕度测试数据：" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Column="1" Height="32" Margin="6,0" FontSize="13" VerticalContentAlignment="Center"
                         IsReadOnly="True" Text="{Binding SourcePath, Mode=OneWay}"
                         Background="{DynamicResource SurfaceAltBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         ToolTip="传导安全裕度测试数据文件（每行：频率,等级）"/>
                <Controls:RoundedButton Grid.Column="2" Content="导入数据" Width="96" Height="32" FontSize="15" CornerRadius="6"
                                        Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                        Command="{Binding ImportCommand}"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="偏置[dB]：" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <mah:NumericUpDown Width="90" Height="30" FontSize="14" Margin="0,0,8,0"
                                       Background="{x:Null}" BorderBrush="{DynamicResource InputBorderBrush}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Value="{Binding OffsetDB, Mode=TwoWay}"/>
                    <Controls:RoundedButton Content="重新应用偏置" Width="120" Height="30" FontSize="14" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Command="{Binding ReapplyOffsetCommand}" Margin="0,0,10,0"/>
                    <TextBlock Text="限值等级 = 导入数据 + 偏置（如安全裕度 +6dB），应用后可在表格中手动微调"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 限值点表格 -->
            <DataGrid Grid.Row="2" Margin="0,10,0,0"
                      ItemsSource="{Binding LimitPoints}"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AutoGenerateColumns="False" CanUserReorderColumns="False"
                      SelectionMode="Single"
                      Background="Transparent" RowHeight="34"
                      BorderBrush="{DynamicResource BorderBrush}" FontSize="14"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="频率 (MHz)" Binding="{Binding FreqMHz, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="限值等级 (dBμA)" Binding="{Binding LevelDB, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 按钮区 -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Controls:RoundedButton Content="添加行" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                            Command="{Binding AddRowCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="删除行" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonDangerBgBrush}" Foreground="{DynamicResource ButtonDangerFgBrush}"
                                            Command="{Binding DeleteRowCommand}" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="清除" Width="90" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Command="{Binding ClearCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Controls:RoundedButton Content="取 消" Width="100" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                            Click="BtnCancel_Click" Margin="0,0,10,0"/>
                    <Controls:RoundedButton Content="保 存" Width="100" Height="34" FontSize="15" CornerRadius="6"
                                            Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
