<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Models="clr-namespace:WpfEMCTestSoftware.Models"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    x:Class="WpfEMCTestSoftware.Views.TestConfigPage"
    DataContext="{Binding TestConfigViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d" FontSize="24"
    d:DesignHeight="910" d:DesignWidth="1840"
    Title="HardwareConfigPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <TreeView ItemsSource="{Binding TreeItems}" SelectedItemChanged="TreeView_SelectedItemChanged"
            SelectedValuePath="Name"
            FontFamily="Microsoft YaHei" FontSize="24">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type Models:TreeItem}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Height="50">
                        <Image Source="{Binding Icon}" Margin="10,0,5,10"/>
                        <Label Content="{Binding Name}" HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center" FontSize="24" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <Grid Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Frame Content="{Binding TemplatePage}" NavigationUIVisibility="Hidden" Margin="1,10,1,1"/>
        </Grid>
        <Controls:StatusIconTextButton HorizontalAlignment="Right" Label="" IconKind="Close"
                                    Height="46" VerticalAlignment="Top" Width="60" IconSize="40"
                                    Command="{Binding CencelCommand}" Background="{x:Null}" Foreground="#FFFF0909"/>
    </Grid>
</Page>
