<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views.PageViews.TestConfigViews" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
      xmlns:models="clr-namespace:WpfEMCTestSoftware.Models" 
      xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
      xmlns:UIControlClass="clr-namespace:Company.UI.Controls.UIControlClass;assembly=Company.UI.Controls"
      xmlns:UseControls="clr-namespace:Company.UI.Controls.UseControls;assembly=Company.UI.Controls" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
      xmlns:testmodels="clr-namespace:WpfEMCTestSoftware.Models.TestModels"
      x:Class="WpfEMCTestSoftware.Views.PageViews.TestConfigViews.RVC_FieldUniformityConfigPage"
      mc:Ignorable="d" 
      DataContext="{Binding RVC_FieldUniformityConfigViewModel, Source={StaticResource Locator}}"
      d:DesignHeight="893" d:DesignWidth="1840"
      Title="RVC_FieldUniformityConfigPage">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding FirstLoadPageCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="85*"/>
        </Grid.ColumnDefinitions>
        <!--操作按钮框-->

        <Grid Grid.Row="3" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="导入配置" Grid.Column="1" Margin="10,25,10,25" Width="180" FontSize="18" Command="{Binding ImportConfigCommand}"/>
            <Button Content="保存配置" Grid.Column="2" Margin="10,25,10,25" Width="180" FontSize="18" Command="{Binding SaveConfigCommand}"/>
            <Button Content="检查配置" Grid.Column="3" Margin="10,25,10,25" Width="180" FontSize="18" Command="{Binding CheckConfigCommand}"/>
            <!-- 第4列是 *，自动留白 -->
            <Button Content="进入测试" Grid.Column="4" Margin="616,25,44,25" Width="180" FontSize="18" Command="{Binding EnterTestCommand}"/>
            <Button Content="退出" Grid.Column="5" Margin="10,25,10,25" Width="180" FontSize="18" Command="{Binding ExitCommand}"/>
        </Grid>
        <!--表格显示-->
        <!-- 整个区域：频段设置（带标题 + 折叠按钮） -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <DataGrid Background="Transparent"
                 ItemsSource="{Binding RVCFieldUniformityConfigModel.ListFreBand,Mode=TwoWay}"
                 CanUserAddRows="False"
                 CanUserDeleteRows="False"
                 AutoGenerateColumns="False"
                 CanUserReorderColumns="False"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 SelectedItem="{Binding CurRVCFreBand,Mode=TwoWay}"                                   
                 IsReadOnly="True" 
                 FontSize="18"
                 FontWeight="Normal" Margin="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                 PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <i:Interaction.Behaviors>
                    <models:SmartDataGridColumnBehavior ModelType="{x:Type testmodels:RVC_FUFreBand}"
             RefreshColumnsTrigger="{Binding RefreshColumnsTrigger}"/>
                </i:Interaction.Behaviors>
            </DataGrid>
            <Button Content="添加" Margin="5,159,5,14" Grid.Column="1" FontSize="18" Height="50" Command="{Binding AddFreqBandCommand }"/>
            <Button Content="删除" Grid.Column="1" Margin="5,94,5,79" FontSize="18" Height="50" Command="{Binding DelFreqBandCommand}"/>
        </Grid>
        <!--测试位置布局-->
        <GroupBox Grid.RowSpan="2" Header="测试位置布局">
            <Grid  Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="32,234,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="130" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="32,123,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="130" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="-12,168,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="112" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="90"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="119,168,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="111" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="90"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="17,91,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="106" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-47.863"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="147,92,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="106" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-47.863"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="103,44,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="130" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="148,202,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="106" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-47.863"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <Controls:ArrowSeparator HorizontalAlignment="Left" Margin="150,129,0,0" Background="#000000" VerticalAlignment="Top" Height="10" Width="210" ShowEndArrow="False" ShowStartArrow="False" RenderTransformOrigin="0.397,0.409">
                        <Controls:ArrowSeparator.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="90"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Controls:ArrowSeparator.RenderTransform>
                    </Controls:ArrowSeparator>
                    <UIControlClass:DashLine HorizontalAlignment="Left" Height="16" Margin="15,192,0,0" VerticalAlignment="Top" Width="105" RenderTransformOrigin="0.5,0.5">
                        <UIControlClass:DashLine.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-47.863"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </UIControlClass:DashLine.RenderTransform>
                    </UIControlClass:DashLine>
                    <UIControlClass:DashLine HorizontalAlignment="Left" Height="8" Margin="104,156,0,0" VerticalAlignment="Top" Width="128"/>
                    <UIControlClass:DashLine HorizontalAlignment="Left" Height="22" Margin="49,94,0,0" VerticalAlignment="Top" Width="110" RenderTransformOrigin="0.5,0.5">
                        <UIControlClass:DashLine.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="90"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </UIControlClass:DashLine.RenderTransform>
                    </UIControlClass:DashLine>
                    <RadioButton Margin="21,228,0,0" Content="1" Background="{Binding ChannelStates[0], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                    IsChecked="{Binding CurrentPoint,Mode=OneWay,Converter={StaticResource ValueToBoolConverter},
                        ConverterParameter=1}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <RadioButton Margin="152,228,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="2" 
                                     Background="{Binding ChannelStates[1], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                         IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                        Converter={StaticResource ValueToBoolConverter},ConverterParameter=2}"/>
                    <RadioButton  Margin="152,118,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="3" Background="{Binding ChannelStates[2], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                          IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                        Converter={StaticResource ValueToBoolConverter},ConverterParameter=3}"/>
                    <RadioButton Margin="21,118,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="4" Background="{Binding ChannelStates[3], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                         IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                         Converter={StaticResource ValueToBoolConverter},ConverterParameter=4}"/>
                    <RadioButton Margin="96,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Content="5" Background="{Binding ChannelStates[4], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                         IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                        Converter={StaticResource ValueToBoolConverter},ConverterParameter=5}"/>
                    <RadioButton Content="6" Margin="222,150,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding ChannelStates[5], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                         IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                            Converter={StaticResource ValueToBoolConverter},ConverterParameter=6}"/>
                    <RadioButton Content="7" Margin="222,39,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding ChannelStates[6], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                         IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                            Converter={StaticResource ValueToBoolConverter},ConverterParameter=7}"/>
                    <RadioButton Margin="93,39,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Content="8" Background="{Binding ChannelStates[7], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                         IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                            Converter={StaticResource ValueToBoolConverter},ConverterParameter=8}"/>
                    <RadioButton  Margin="104,187,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top" Content="9" Background="{Binding ChannelStates[8], Converter={StaticResource ChannelStatusToBrushConverter}}"
                                          IsChecked="{Binding CurrentPoint,Mode=OneWay,
                                Converter={StaticResource ValueToBoolConverter},ConverterParameter=9}"/>
                </Grid>

                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" VerticalAlignment="Bottom">
                    <!-- 统一用 Grid 来做每一行的水平布局，共享列定义 -->
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <!-- 第一列：标签列，给固定宽度 -->
                            <ColumnDefinition Width="102"/>
                            <!-- 第二列：ComboBox列，给固定宽度，剩余空间自动填充 -->
                            <ColumnDefinition Width="168"/>
                            <!-- 可选：如果需要更多控件，可以继续加列 -->
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                        Grid.Column="0"
                        TextWrapping="Wrap" 
                        VerticalAlignment="Center" 
                        Text="测试标准" 
                        FontSize="20" 
                        Foreground="Black" 
                        FontWeight="Normal" />

                        <ComboBox 
                            Grid.Column="1"                          
                            Height="40" 
                            Background="#ffffff" 
                            BorderBrush="#FFD9D9D9" 
                            ItemsSource="{Binding  StandardList}"
                            DisplayMemberPath="ShowText" 
                            SelectedValuePath="RealValue"
                            SelectedValue="{Binding RVCFieldUniformityConfigModel.CurEMSStandard, Mode=TwoWay}" 
                            FontWeight="Normal" 
                            FontSize="16">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding StandComboxChangeCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                    </Grid>

                    <!-- 第二行：位置点数 -->
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="73"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                            Grid.Column="0"
                            TextWrapping="Wrap" 
                            VerticalAlignment="Center" 
                            Text="位置点数" 
                            FontSize="20" 
                            Foreground="Black" 
                            FontWeight="Normal" />

                        <ComboBox 
                            Grid.Column="1"                      
                            Height="40" 
                            Background="#ffffff" 
                            BorderBrush="#FFD9D9D9" 
                            ItemsSource="{Binding PointSelectList}"
                            DisplayMemberPath="ShowText" 
                            SelectedValuePath="RealValue"
                            SelectedValue="{Binding RVCFieldUniformityConfigModel.MinPositionPoints, Mode=TwoWay}" 
                            FontWeight="Normal" 
                            FontSize="16" Grid.ColumnSpan="2">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectPositionPointCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                    </Grid>

                    <!-- 第三行：当前测试点 -->
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="168"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                            Grid.Column="0"
                            TextWrapping="Wrap" 
                            VerticalAlignment="Bottom" 
                            Text="当前测试点" 
                            FontSize="20" 
                            Foreground="Black" 
                            FontWeight="Normal" Margin="0,0,0,7" />

                        <ComboBox 
                            Grid.Column="1"
                            Height="40" 
                            Background="#ffffff" 
                            BorderBrush="#FFD9D9D9" 
                            ItemsSource="{Binding CurrentPointList}"                          
                            SelectedItem="{Binding RVCFieldUniformityConfigModel.CurrentTestPoint}" 
                            FontWeight="Normal" 
                            FontSize="16" Margin="0,0,0,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CurrentSelectPointCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                    </Grid>

                    <!-- 第四行：调整优先级 -->
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="168"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                            Grid.Column="0"
                            TextWrapping="Wrap" 
                            VerticalAlignment="Center" 
                            Text="调整优先级" 
                            FontSize="20" 
                            Foreground="Black" 
                            FontWeight="Normal" />

                        <ComboBox 
                            Grid.Column="1"
                            Height="40" 
                            Background="#ffffff" 
                            BorderBrush="#FFD9D9D9" 
                            ItemsSource="{Binding AdjustPriority}"
                            DisplayMemberPath="ShowText" 
                            SelectedValuePath="RealValue"
                            SelectedValue="{Binding RVCFieldUniformityConfigModel.AdjustmentPriority, Mode=TwoWay}" 
                            FontWeight="Normal" 
                            FontSize="16">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding StandComboxChangeCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                    </Grid>

                    <!-- 剩下的 CheckBox 和图例部分 -->
                    <CheckBox Content="加载测试" HorizontalAlignment="Left" Margin="0 5 0 5"/>
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 5">
                        <Rectangle Width="60" Height="20" Fill="White" Stroke="Black"/>
                        <TextBlock Text="未测试点" Margin="20 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 5">
                        <Rectangle Width="60" Height="20" Fill="Green" Stroke="Black"/>
                        <TextBlock Text="测试完成点" Margin="20 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 5">
                        <Rectangle Width="60" Height="20" Fill="Yellow" Stroke="Black"/>
                        <TextBlock Text="部分测试点" Margin="20 0 0 0"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </GroupBox>
        <!--硬件模板-->
        <GroupBox Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Header="频段设置">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Frame Content="{Binding CurHardPage}" NavigationUIVisibility="Hidden"/>
                <Grid Grid.Column="1">
                    <Grid x:Name="ContentGrid" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.5*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========== 左上：频率设置 ========== -->
                        <GroupBox Header="频率设置" Grid.Column="0" Grid.Row="0" Margin="0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6*" MinWidth="65"/>
                                    <ColumnDefinition Width="10*" MinWidth="90"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 起始频率 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="起始频率" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="0" Grid.Column="1" Height="25" BorderBrush="#FF84A4A4" BorderThickness="1"
                           Value="{Binding CurRVCFreBand.StartFre, Mode=TwoWay}" Background="White" Foreground="Black"/>
                                <ComboBox Grid.Row="0" Grid.Column="2" BorderBrush="#FF84A4A4" Margin="0 5 0 5"
                                ItemsSource="{Binding FreUnitList}" 
                                DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                SelectedValue="{Binding CurRVCFreBand.StartFreUnit,Mode=TwoWay}">
                                    <ComboBox.Background>
                                        <SolidColorBrush Color="White" Opacity="0.8"/>
                                    </ComboBox.Background>
                                </ComboBox>

                                <!-- 终止频率 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="终止频率" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Height="25" BorderBrush="#FF84A4A4" BorderThickness="1" Background="White"
                           Value="{Binding CurRVCFreBand.EndFreq, Mode=TwoWay}" Margin="0,6,2,0" Foreground="Black" VerticalAlignment="Top"/>
                                <ComboBox Grid.Row="1" Grid.Column="2" BorderBrush="#FF84A4A4" Margin="0 5 0 5"
                            ItemsSource="{Binding FreUnitList}" 
                            DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                            SelectedValue="{Binding CurRVCFreBand.EndFreUnit,Mode=TwoWay}">
                                    <ComboBox.Background>
                                        <SolidColorBrush Color="White" Opacity="0.8"/>
                                    </ComboBox.Background>
                                </ComboBox>
                                <!-- 频率步进 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap" 
                                   Text="频率步进" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="2" Grid.Column="1"  
                                   FontSize="24" BorderBrush="Gainsboro" Foreground="Black" Margin="0 5 0 5"
                                   Value="{Binding CurRVCFreBand.Stepsize,Mode=TwoWay}" Background="#FFFBFBFB"/>
                                <ComboBox Grid.Row="2" Grid.Column="2" BorderBrush="#FF84A4A4" Margin="0 5 0 5"
                                        ItemsSource="{Binding FreUnitList}" 
                                        DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                        SelectedValue="{Binding CurRVCFreBand.StepUnit,Mode=TwoWay}">
                                    <ComboBox.Background>
                                        <SolidColorBrush Color="White" Opacity="0.8"/>
                                    </ComboBox.Background>
                                </ComboBox>
                                <!-- 步进类型 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="步进类型" FontSize="14"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Height="26" BorderBrush="#FF84A4A4"
                                  ItemsSource="{Binding StepModesList}"
                                  SelectedItem="{Binding CurRVCFreBand.Mstepmode, Mode=TwoWay}" Foreground="Black">
                                    <ComboBox.Background>
                                        <SolidColorBrush Color="White" Opacity="0.8"/>
                                    </ComboBox.Background>
                                </ComboBox>
                                <!-- 第三列无内容，留空即可 -->

                              
                                <!-- 驻留时间 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="驻留时间" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="4" Grid.Column="1" Height="25" BorderBrush="#FF84A4A4" BorderThickness="1"
                           Value="{Binding CurRVCFreBand.FreqDwellTime, Mode=TwoWay}" Background="White" Foreground="Black"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="ms" FontSize="14" Margin="8,0,0,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- ========== 右上：电平设置（跨2行） ========== -->
                        <GroupBox Header="电平设置" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="13*" />
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 干扰电平限值 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="干扰电平限值" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="0" 
                               BorderBrush="#FF84A4A4" 
                               BorderThickness="1"
                               Value="{Binding CurRVCFreBand.InterferenceLevelLimit, Mode=TwoWay}"  Margin="100,12,2,11" Grid.ColumnSpan="2" Background="White" Foreground="Black"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="V/m" FontSize="14" Margin="8,0,0,0"/>

                                <!-- 场强限值精度 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="场强限值精度" FontSize="14"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="LOG" FontSize="12" HorizontalAlignment="Right" Margin="0,0,45,49" Grid.RowSpan="2"
                                          IsChecked="{Binding CurRVCFreBand.IsOffsetLog, Mode=TwoWay}"/>

                                <!-- 上偏移 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="上偏移" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="2" Grid.Column="1" 
                           Height="25" 
                           BorderBrush="#FF84A4A4" 
                           BorderThickness="1"
                           
                           Value="{Binding CurRVCFreBand.UpperOffsetDb, Mode=TwoWay}" Foreground="Black" Background="White"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="dB" FontSize="14" Margin="8,0,0,0"/>

                                <!-- 下偏移 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="下偏移" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="3" Grid.Column="1" 
                               Height="25" 
                               BorderBrush="#FF84A4A4" 
                               BorderThickness="1"
                               Value="{Binding CurRVCFreBand.LowerOffsetDb, Mode=TwoWay}"   Foreground="Black" Background="White"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="dB" FontSize="14" Margin="8,0,0,0"/>

                                <!-- 下一频点电平调整 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="下一频点电平调整" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="4" Grid.Column="1" 
                           Height="25" 
                           BorderBrush="#FF84A4A4" 
                           BorderThickness="1"
                           HorizontalAlignment="Stretch"
                           Value="{Binding CurRVCFreBand.NextPointLevelAdjustDb, Mode=TwoWay}" Foreground="Black" Background="White"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="dB" FontSize="14" Margin="8,0,0,0"/>

                                <!-- 功放线性度检查 -->
                                <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="功放线性度检查" 
                                          IsChecked="{Binding CurRVCFreBand.IsPowerAmpLinearCheckEnabled , Mode = TwoWay}"/>

                                <!-- 线性度调整范围 -->
                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="线性度调整范围" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="6" Grid.Column="1" 
                           Height="25" 
                           BorderBrush="#FF84A4A4" 
                           BorderThickness="1"
                           HorizontalAlignment="Stretch"
                           Background="White"
                           Value="{Binding CurRVCFreBand.LinearAdjustRangeDb, Mode=TwoWay}" Foreground="Black"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Text="dB" FontSize="14" Margin="8,0,0,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- ========== 左下：天线效率设置 ========== -->
                        <GroupBox Grid.Column="0" Grid.Row="1" Header="天线效率设置" Margin="0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" MinWidth="75"/>
                                    <ColumnDefinition Width="12*" MinWidth="90"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 发射天线 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="发射天线" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="0" Grid.Column="1" Height="25" BorderBrush="#FF84A4A4" BorderThickness="1"
                           Value="{Binding CurRVCFreBand.TxAntennaEfficiency, Mode=TwoWay}" Background="White" Foreground="Black"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="%" FontSize="14" Margin="8,0,0,0"/>

                                <!-- 接收天线 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="接收天线" FontSize="14"/>
                                <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Height="25" BorderBrush="#FF84A4A4" BorderThickness="1"
                           Value="{Binding CurRVCFreBand.RxAntennaEfficiency, Mode=TwoWay}" Background="White" Foreground="Black"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="%" FontSize="14" Margin="8,0,0,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- ========== 左中下：搅拌器设置 ========== -->
                        <GroupBox Grid.Column="0" Grid.Row="2" Header="搅拌器设置" Margin="0">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" MinWidth="75"/>
                                    <ColumnDefinition Width="12*" MinWidth="90"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="驻留时间" FontSize="14"/>
                                <mah:NumericUpDown Grid.Column="1" Height="25" BorderBrush="#FF84A4A4" BorderThickness="1"
                                       Value="{Binding CurRVCFreBand.StirrerDwellTime , Mode=TwoWay}" Background="White" Foreground="Black"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="ms" FontSize="14" Margin="8,0,0,0"/>

                            </Grid>
                        </GroupBox>

                        <!-- ========== 右中下：谐波测试设置 ========== -->
                        <GroupBox Grid.Column="1" Grid.Row="2" Header="谐波测试设置" Margin="0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="测试方法" FontSize="14"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Width="106" Height="24" Margin="0,2" Foreground="Black"  SelectedValue="{Binding CurRVCFreBand.HarmonicTestMethod, Mode=TwoWay}">
                                    <ComboBox.Background>
                                        <SolidColorBrush Color="White" Opacity="0.8"/>
                                    </ComboBox.Background>
                                </ComboBox>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5">
                                    <CheckBox Content="二次谐波" Margin="0,0,15,0" IsChecked="{Binding CurRVCFreBand.TestSecondHarmonic, Mode=TwoWay}"/>
                                    <CheckBox Content="三次谐波" IsChecked="{Binding CurRVCFreBand. TestThirdHarmonic, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>


                    </Grid>
                </Grid>

            </Grid>

        </GroupBox>





    </Grid>
</Page>
