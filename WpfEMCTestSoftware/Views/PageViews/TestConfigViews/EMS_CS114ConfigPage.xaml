                                <TextBlock Text="下电时间[ms]：" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <mah:NumericUpDown Width="90" Height="30" FontSize="14" Background="{x:Null}"
                                                   BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Value="{Binding CS114TestModel.GeneralCS114Parms.PowerOffMs, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
