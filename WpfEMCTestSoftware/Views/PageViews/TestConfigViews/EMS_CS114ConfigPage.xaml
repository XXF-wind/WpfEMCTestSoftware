                                                               BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Value="{Binding FmRateKHz, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <mah:NumericUpDown Width="76" Height="30" FontSize="14" Margin="0,0,8,0" Background="{x:Null}"
