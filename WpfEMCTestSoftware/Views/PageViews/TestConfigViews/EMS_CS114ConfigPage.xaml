                    </TabItem>
                    <TabItem Header="调制方式" Style="{StaticResource Cs114TabItemStyle}">
                        <Grid Margin="10,8,10,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
