                                <mah:NumericUpDown Width="70" Height="30" FontSize="14" Margin="0,0,14,0" Background="{x:Null}"
                                                   BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Value="{Binding CS114TestModel.GeneralCS114Parms.BiasVoltageV, Mode=TwoWay}"/>
                                <TextBlock Text="输出电压[V]：" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <mah:NumericUpDown Width="70" Height="30" FontSize="14" Background="{x:Null}"
                                                   BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Value="{Binding CS114TestModel.GeneralCS114Parms.OutputVoltageV, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,331,0">
                                <TextBlock Text="功率单位：" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox Width="80" Height="30" FontSize="14" Margin="0,0,14,0" VerticalContentAlignment="Center"
                                          Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                          SelectedItem="{Binding CS114TestModel.GeneralCS114Parms.PowerUnit, Mode=TwoWay}">
                                    <sys:String>W</sys:String>
                                    <sys:String>dBm</sys:String>
                                </ComboBox>
                                <TextBlock Text="等级Y轴：" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox Width="90" Height="30" FontSize="14" Margin="0,0,14,0" VerticalContentAlignment="Center"
                                          Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                          SelectedItem="{Binding CS114TestModel.GeneralCS114Parms.LevelAxisMode, Mode=TwoWay}">
                                    <sys:String>Linear</sys:String>
                                    <sys:String>Log</sys:String>
                                </ComboBox>
                                <TextBlock Text="Y轴最小/最大：" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <mah:NumericUpDown Width="70" Height="30" FontSize="14" Margin="0,0,8,0" Background="{x:Null}"
                                                   BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Value="{Binding CS114TestModel.GeneralCS114Parms.LevelAxisMin, Mode=TwoWay}"/>
                                <mah:NumericUpDown Width="70" Height="30" FontSize="14" Background="{x:Null}"
                                                   BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Value="{Binding CS114TestModel.GeneralCS114Parms.LevelAxisMax, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="系数列表" Style="{StaticResource Cs114TabItemStyle}">
                        <Grid Margin="8,8,8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid Background="Transparent"
                                      ItemsSource="{Binding CurFreBand.BandParms.CableLosses}"
                                      SelectedItem="{Binding CurLinkCoeff, Mode=TwoWay}"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      AutoGenerateColumns="False" CanUserReorderColumns="False"
                                      IsReadOnly="True" SelectionMode="Single"
                                      FontSize="13" RowHeight="28"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      BorderBrush="{DynamicResource BorderBrush}">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCurCoeffCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="链路名称" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="系数点数" Binding="{Binding PointCountText}" MinWidth="70"/>
                                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" MinWidth="60"/>
                                    <DataGridTextColumn Header="更新时间" Binding="{Binding LastModified}" MinWidth="120"/>
                                    <DataGridTemplateColumn Header="状态" MinWidth="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0">
                                <Controls:RoundedButton Content="编辑系数" Width="96" Height="32" FontSize="15" CornerRadius="6"
                                                        Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                                                        Command="{Binding EditCurCoeffCommand}" Margin="0,0,0,8"/>
                                <Controls:RoundedButton Content="清除系数" Width="96" Height="32" FontSize="15" CornerRadius="6"
                                                        Background="{DynamicResource ButtonDangerBgBrush}" Foreground="{DynamicResource ButtonDangerFgBrush}"
                                                        Command="{Binding ClearCoeffCommand}"
                                                        CommandParameter="{Binding CurLinkCoeff}"/>
                                <TextBlock Text="双击行可直接编辑" FontSize="11" Margin="0,6,0,0" TextAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="当前频段的链路系数汇总（也可直接点击左侧连接图上的链路标签编辑）；保存配置后下次使用自动带出。"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="使用说明" Style="{StaticResource Cs114TabItemStyle}">
                        <StackPanel Margin="10,10,10,4">
                            <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="① 测试频段在表格中直接编辑：可添加频段、删除频段，选中某行后下方硬件模板、链路系数与 limit 显示都会切换到该频段；&#x0a;② 分频段下设备可能接得不一样：切换频段后重新选择设备、扫描仪器地址即可，各频段互不影响；&#x0a;③ 点击硬件连接图上的设备图标，可自动扫描或手动获取仪器通讯地址；&#x0a;④ 点击链路上的 dB 标签，可添加/导入/导出该链路损耗系数，标签实时显示已添加/未添加；&#x0a;⑤ 执行标准、测试阶段等不分频段的参数在本页签配置；配置完成后点击下方保存，下次使用自动加载。"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ═══════════ 测试频段（DataGrid 直接编辑）+ 非分频段参数 Tab ═══════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 频段列表标题 + 添加/删除 -->
                    <Grid Margin="2,0,2,4">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="5" Height="20" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center"/>
                            <TextBlock Text="测试频段" FontSize="18" FontWeight="Bold" Margin="10,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="（选中频段后下方硬件模板随之切换，可直接在表格内修改参数）" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Controls:RoundedButton Content="添加频段" Width="96" Height="32" FontSize="15" CornerRadius="6"
                                                Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource TextOnAccentBrush}"
                                                Command="{Binding AddFreqBandCommand}" Margin="0,0,8,0"/>
                            <Controls:RoundedButton Content="删除频段" Width="96" Height="32" FontSize="15" CornerRadius="6"
                                                Background="{DynamicResource ButtonDangerBgBrush}" Foreground="{DynamicResource ButtonDangerFgBrush}"
                                                Command="{Binding DelFreqBandCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 分频段参数表（可直接编辑） -->
                    <DataGrid Grid.Row="1" Height="210" Background="Transparent"
                          ItemsSource="{Binding CS114TestModel.ListFreBands, Mode=TwoWay}"
                          SelectedItem="{Binding CurFreBand, Mode=TwoWay}"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          AutoGenerateColumns="False" CanUserReorderColumns="False"
                          IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow"
                          FontSize="14" RowHeight="34" RowHeaderWidth="36"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch" BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="起始频率" Binding="{Binding StartFre, UpdateSourceTrigger=LostFocus}" MinWidth="78"/>
                            <DataGridTemplateColumn Header="单位" MinWidth="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource GridComboStyle}"
                                              ItemsSource="{Binding DataContext.FreUnitList, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                              SelectedValue="{Binding StartFreUnit, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="终止频率" Binding="{Binding EndFreq, UpdateSourceTrigger=LostFocus}" MinWidth="78"/>
                            <DataGridTemplateColumn Header="单位" MinWidth="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource GridComboStyle}"
                                              ItemsSource="{Binding DataContext.FreUnitList, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                              SelectedValue="{Binding EndFreUnit, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="起始等级" Binding="{Binding BandParms.StartLevel, UpdateSourceTrigger=LostFocus}" MinWidth="76"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="终止等级" Binding="{Binding BandParms.EndLevel, UpdateSourceTrigger=LostFocus}" MinWidth="76"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="步进" Binding="{Binding Stepsize, UpdateSourceTrigger=LostFocus}" MinWidth="66"/>
                            <DataGridTemplateColumn Header="步进单位" MinWidth="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 步进模式 = LIN：步进是频率差，单位可选；步进模式 = LOG：步进是百分比，单位固定显示 % -->
                                        <Grid>
                                            <ComboBox DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                                  ItemsSource="{Binding DataContext.FreUnitList, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  SelectedValue="{Binding StepUnit, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource GridComboStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLogStepMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Text="{Binding StepUnitText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLogStepMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="步进模式" MinWidth="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource GridComboStyle}"
                                              ItemsSource="{Binding DataContext.StepModesList, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                              SelectedValue="{Binding Mstepmode, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="调制" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource GridComboStyle}"
                                              ItemsSource="{Binding DataContext.ModList, RelativeSource={RelativeSource AncestorType=Page}}"
                                              SelectedItem="{Binding BandParms.ModulationText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="驻留(ms)" Binding="{Binding FreqDwellTime, UpdateSourceTrigger=LostFocus}" MinWidth="72"/>
                            <DataGridTemplateColumn Header="限值类型" MinWidth="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource GridComboStyle}"
                                              ItemsSource="{Binding DataContext.LimitTypeList, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                              SelectedValue="{Binding BandParms.LimitMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="限值数据" MinWidth="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Controls:RoundedButton Content="{Binding BandParms.LimitPointCountText}" Width="84" Height="26" FontSize="13" CornerRadius="5"
                                                            Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                                                            Command="{Binding DataContext.OpenLimitImportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="导入传导安全裕度测试数据 + 偏置（默认+6dB）生成本频段限值曲线，可查看/修改已导入的点"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="上限裕度" Binding="{Binding BandParms.UpperLimit, UpdateSourceTrigger=LostFocus}" MinWidth="76"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridTextStyle}" Header="限值文件" Binding="{Binding BandParms.ImmunityTableAddr, UpdateSourceTrigger=LostFocus}" MinWidth="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>

            </Grid>
        </Grid>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
            <Controls:StatusIconTextButton Width="150"
                IconSize="70" FontSize="25" Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Label="{DynamicResource ExitTitle}" IconKind="ExitToApp"
                Command="{Binding ExitTestConfigCommand}"
                HorizontalAlignment="Left"/>
            <Controls:StatusIconTextButton Width="150"
                IconSize="70" FontSize="25" Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource AccentBrush}"
                Label="{DynamicResource SaveASConfigTitle}" IconKind="ContentSaveAll"
                Command="{Binding SaveAsTestConfigCommand}"/>
            <Controls:StatusIconTextButton Width="150"
                IconSize="70" FontSize="25" Background="{DynamicResource SurfaceAltBrush}"
                Foreground="{DynamicResource SuccessBrush}"
                Label="{DynamicResource SaveConfigTitle}" IconKind="ContentSaveEdit"
                Command="{Binding SaveTestConfigCommand}"/>
        </StackPanel>
    </Grid>
</Page>
