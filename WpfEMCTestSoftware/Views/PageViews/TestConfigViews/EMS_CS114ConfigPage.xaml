<Page x:Class="WpfEMCTestSoftware.Views.PageViews.TestConfigViews.EMS_CS114ConfigPage"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views.PageViews.TestConfigViews"
      xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
      xmlns:models="clr-namespace:WpfEMCTestSoftware.Models" 
      xmlns:testmodels="clr-namespace:WpfEMCTestSoftware.Models.TestModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
      DataContext="{Binding EMS_CS114ConfigViewModel ,Source={StaticResource Locator}}"
      d:DesignHeight="893" d:DesignWidth="1840"     
      PreviewTextInput="Page_PreviewTextInput"
      PreviewKeyDown="Page_PreviewKeyDown"
      Title="EMS_CS114ConfigPage">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding FirstLoadPageCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding PageUnloadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 硬件连接图上的链路系数标签样式：状态圆点 + 链路名 + 状态文字，点击打开系数弹窗 -->
        <Style x:Key="LinkChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Command" Value="{Binding OpenCoeffDialogCommand}"/>
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1.5" Padding="7,3"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 状态圆点：橙色=未添加 绿色=已添加 -->
                                <Ellipse x:Name="dot" Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource WarningBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Tag.StatusText, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="10.5" Margin="0,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag.IsConfigured, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag.IsConfigured, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip" Value="点击添加/导入该链路损耗系数（dB）"/>
        </Style>
        <!-- 设备地址标签样式：点击打开仪器地址弹窗 -->
        <Style x:Key="AddrChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="ToolTip" Value="点击获取/设置仪器地址（自动扫描或手动输入）"/>
        </Style>
        <!-- TabControl 页签样式（非分频段参数区） -->
        <Style x:Key="Cs114TabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="16,7">
                            <ContentPresenter ContentSource="Header" x:Name="hd"
                                              TextElement.FontSize="15"
                                              TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="hd" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="hd" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="hd" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid 下拉列单元格样式 -->
        <Style x:Key="GridComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- DataGrid 文字列单元格居中样式 -->
        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ 硬件模板（随选中频段切换）═══════════ -->
            <!-- ═══════════ 下部：硬件模板（左）+ 参数配置（右）═══════════ -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="5" Height="20" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <!-- 标题随测试项变化（CS114/CE101/RE102/RS103 共用本配置页） -->
                            <TextBlock Text="{Binding HardwareTemplateTitle}" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <!-- 硬件连接图 -->
                        <Viewbox Stretch="Uniform" Margin="4">
                            <Grid Width="1150" Height="560">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <!-- limit（信号源限制值，随频段限制值联动） -->
                                <!-- ══ CDN（耦合去耦网络，另一种注入方式，虚线表示可选连接）══ -->

                                <!-- ══ CDN（耦合去耦网络，另一种注入方式，虚线表示可选连接）══ -->

                                <Line X1="0" Y1="0" X2="0" Y2="67" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="3 3"
                                 Margin="915,211,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None"/>

                                <!-- ══ CDN（耦合去耦网络，另一种注入方式，虚线表示可选连接）══ -->


                                <!-- limit（信号源限制值，随频段限制值联动） -->

                                <!-- ══ 无源设备 ══ -->
                                <Border Margin="700,64,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="263" Height="286" BorderThickness="2" CornerRadius="8"
                                    BorderBrush="{DynamicResource AccentHoverBrush}" Background="{x:Null}"/>

                                <Rectangle Margin="736,205,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="65" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="841,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="73" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="839,205,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Width="73" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="736,98,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="65" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="821,308,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="73" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="860,152,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="109" Height="2" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="90"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Margin="680,151,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="109" Height="2" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="90"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Border Margin="800,177,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="68" Height="58" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <StackPanel>
                                        <Image Source="/Images/CS114_InjectProbe.png" Height="35" Stretch="Uniform"/>
                                        <TextBlock Text="注入探头" FontSize="14" TextAlignment="Center"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Margin="754,280,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="67" Height="58" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="/Images/CS114_EUT.png" Height="34" Stretch="Uniform"/>
                                        <TextBlock Text="EUT" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="878,266,0,218" HorizontalAlignment="Left"
                               Width="67" CornerRadius="6" BorderThickness="1"
                               Background="{DynamicResource SurfaceAltBrush}"
                               BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <StackPanel Margin="0,0,0,0">
                                        <Image Source="/Images/CS114_MonitorProbe.png" Stretch="Uniform" Height="47" Width="44"/>
                                        <TextBlock Text="监测探头" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="800,71,0,0"  HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="67" Height="58" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <StackPanel>
                                        <Image Source="/Images/CS114_CDN.png" Height="35" Stretch="Uniform"/>
                                        <TextBlock Text="CDN" FontSize="14" TextAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>





                                <Rectangle Margin="170,99,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Width="90" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="410,99,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Width="30" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="640,99,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Width="60" Height="2" Fill="{DynamicResource AccentBrush}"/>


                                <Rectangle Margin="454,134,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Width="2" Height="166" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Margin="609,134,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Width="2" Height="166" Fill="{DynamicResource AccentBrush}"/>

                                <!-- ══ 有地址的设备（点击图标自动/手动获取仪器地址）══ -->
                                <StackPanel Margin="20,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150">
                                    <Button Height="50" Width="80" HorizontalAlignment="Center" Margin="3"
                                        Style="{DynamicResource NoHoverButtonStyle}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding OpenAddressScanCommand}" CommandParameter="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[0]}"
                                        ToolTip="点击获取/设置仪器地址（自动扫描或手动输入）">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/Images/signalsource.png" Stretch="Uniform"/>
                                        </Button.Background>
                                    </Button>
                                    <ComboBox Height="26" Margin="2" FontSize="15"
                                          SelectedItem="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[0].Name}"
                                          ItemsSource="{Binding SignalSourceNames}"/>
                                    <Border Style="{StaticResource AddrChipStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenAddressScanCommand}"
                                                      CommandParameter="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[0]}"/>
                                        </Border.InputBindings>
                                    </Border>
                                    <TextBlock Text="信号源" FontSize="14" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="260,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150">
                                    <Button Height="50" Width="90" HorizontalAlignment="Center" Margin="3"
                                        Style="{DynamicResource NoHoverButtonStyle}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding OpenAddressScanCommand}" CommandParameter="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[1]}"
                                        ToolTip="点击获取/设置仪器地址（自动扫描或手动输入）">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/Images/Amplifier.png" Stretch="Uniform"/>
                                        </Button.Background>
                                    </Button>
                                    <ComboBox Height="26" Margin="2" FontSize="15"
                                          SelectedItem="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[1].Name}"
                                          ItemsSource="{Binding AmplifierNames}"/>
                                    <TextBlock Text="功率放大器" FontSize="14" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="390,300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150">
                                    <Button Height="46" Width="70" HorizontalAlignment="Center" Margin="3"
                                        Style="{DynamicResource NoHoverButtonStyle}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding OpenAddressScanCommand}" CommandParameter="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[2]}"
                                        ToolTip="点击获取/设置仪器地址（自动扫描或手动输入）">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/Images/inputpower.png" Stretch="Uniform"/>
                                        </Button.Background>
                                    </Button>
                                    <ComboBox Height="26" Margin="2" FontSize="15"
                                          SelectedItem="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[2].Name}"
                                          ItemsSource="{Binding PowerMeterames}"/>
                                    <TextBlock Text="前向功率计" FontSize="14" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="545,300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150">
                                    <Button Height="46" Width="70" HorizontalAlignment="Center" Margin="3"
                                        Style="{DynamicResource NoHoverButtonStyle}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding OpenAddressScanCommand}" CommandParameter="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[3]}"
                                        ToolTip="点击获取/设置仪器地址（自动扫描或手动输入）">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/Images/outputpower.png" Stretch="Uniform"/>
                                        </Button.Background>
                                    </Button>
                                    <ComboBox Height="26" Margin="2" FontSize="15"
                                          SelectedItem="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[3].Name}"
                                          ItemsSource="{Binding PowerMeterames}"/>
                                    <TextBlock Text="反向功率计" FontSize="14" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="625,395,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"/>

                                <!-- ══ 无源部件 ══ -->
                                <Border Margin="440,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="200" Height="70" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <TextBlock Text="双定向耦合器" FontSize="15" FontWeight="Bold" TextAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>


                                <!-- ══ 链路系数标签（dB=链路损耗；点击编辑系数；已添加/未添加一目了然）══ -->
                                <Button Style="{StaticResource LinkChipStyle}" Margin="167,75,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Tag="{Binding CurFreBand.BandParms.CableLosses[0]}" Width="96"/>
                                <Button Style="{StaticResource LinkChipStyle}" Margin="545,8,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Tag="{Binding CurFreBand.BandParms.CableLosses[1]}"/>
                                <Button Style="{StaticResource LinkChipStyle}" Margin="400,236,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Tag="{Binding CurFreBand.BandParms.CableLosses[2]}" Width="109"/>
                                <Button Style="{StaticResource LinkChipStyle}" Margin="554,234,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Tag="{Binding CurFreBand.BandParms.CableLosses[3]}"/>

                                <!-- ══ 监测探头（电流探头，无源，卡在注入探头与EUT之间的电缆束上）══ -->
                                <Rectangle Margin="1056,193,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="2" Height="243" Fill="{DynamicResource AccentBrush}"/>


                                <!-- ══ 测量接收机（监测探头输出，可配地址仪器槽位5）══ -->
                                <StackPanel Margin="981,428,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150">
                                    <Button Height="46" Width="130" HorizontalAlignment="Center" Margin="3"
                                        Style="{DynamicResource NoHoverButtonStyle}" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding OpenAddressScanCommand}" CommandParameter="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[4]}"
                                        ToolTip="点击获取/设置仪器地址（自动扫描或手动输入）">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/Images/receiver.png" Stretch="Uniform"/>
                                        </Button.Background>
                                    </Button>
                                    <ComboBox Height="26" Margin="2" FontSize="15"
                                          SelectedItem="{Binding CurFreBand.RVCHardModel.ListDeviceInfos[4].Name}"
                                          ItemsSource="{Binding ReceiverNames}"/>
                                    <TextBlock Text="测量接收机" FontSize="14" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <!-- 图例 -->
                                <TextBlock Margin="20,528,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="图例：dB = 该链路损耗系数　|　limit = 信号源限制值　|　监测探头 = 电流探头（无源）　|　点击链路标签编辑系数　"/>
                                <Rectangle Margin="963,193,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="93" Height="2" Fill="{DynamicResource AccentBrush}"/>
                                <Button Style="{StaticResource LinkChipStyle}" Margin="1000,232,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Tag="{Binding CurFreBand.BandParms.CableLosses[4]}"/>

                            </Grid>
                        </Viewbox>
                    </Grid>
                </GroupBox>
                <!-- 非分频段参数：TabControl -->
                <TabControl Grid.Column="1" Margin="8,0,0,0"
                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
                    <TabItem Header="通用配置" Style="{StaticResource Cs114TabItemStyle}">
                        <Grid Margin="14,10,14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="执行标准" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ComboBox Height="36" Margin="0,8,12,0" FontSize="15" HorizontalAlignment="Stretch"
                                          Background="{DynamicResource InputBackgroundBrush}"
                                          BorderBrush="{DynamicResource InputBorderBrush}"
                                          ItemsSource="{Binding StandardList}"
                                          DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                          SelectedValue="{Binding CS114TestModel.CurEMSStandard, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="测试阶段" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ComboBox Height="36" Margin="0,8,0,0" FontSize="15" HorizontalAlignment="Stretch"
                                          Background="{DynamicResource InputBackgroundBrush}"
                                          BorderBrush="{DynamicResource InputBorderBrush}"
                                          ItemsSource="{Binding TestStageTypelist}"
                                          DisplayMemberPath="ShowText" SelectedValuePath="RealValue"
                                          SelectedValue="{Binding CS114TestModel.CurTestStageType, Mode=TwoWay}"/>
                            </StackPanel>
                            <!-- 校准数据导入：仅正式测试阶段可见，导入后随"保存"写入 .cs114 配置 -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="导入校准数据" Height="32" Padding="16,0" FontSize="14"
                                        Command="{Binding ImportCalDataCommand}"
                                        Visibility="{Binding IsFormalTest, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding CalDataStatusText}" FontSize="12" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
