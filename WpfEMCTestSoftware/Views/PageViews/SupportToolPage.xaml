<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Class="WpfEMCTestSoftware.Views.SupportToolPage"
    DataContext="{Binding SupportToolViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d" FontSize="16"
    d:DesignHeight="893" d:DesignWidth="1840"
    Title="SupportToolPage">

    <Page.Resources>
        <!-- 工具卡片按钮：主题圆角卡片 + 悬浮强调边框 -->
        <Style x:Key="ToolCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="180"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="20,18,20,16">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 虚线按钮（添加测试项 / 占位卡片） -->
        <Style x:Key="DashedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Rc" RadiusX="12" RadiusY="12" Fill="Transparent"
                                       Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                                       StrokeDashArray="4 3"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rc" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Margin="28,24,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="TEST MODULE LIBRARY" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="测试选项" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Microsoft YaHei" Margin="0,8,0,0"/>
                <TextBlock Text="04 个功能模块，点击卡片进入对应测试页面" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Microsoft YaHei" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Height="42" Padding="16,0" VerticalAlignment="Center"
                    Style="{StaticResource DashedButtonStyle}" Command="{Binding AddToolCommand}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Plus" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="添加测试项" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Microsoft YaHei" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 卡片网格 + 占位 -->
        <ScrollViewer Grid.Row="1" Margin="28,18,28,20" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 顶部：图标 + 标签 -->
                                    <Grid>
                                        <Border Width="48" Height="48" CornerRadius="12"
                                                Background="{DynamicResource AccentLightBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <md:PackIcon Kind="{Binding Icon}" Width="26" Height="26"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="10"
                                                Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Tag}" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}" FontFamily="Microsoft YaHei"/>
                                        </Border>
                                    </Grid>

                                    <!-- 标题 + 描述 -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Microsoft YaHei"/>
                                        <TextBlock Text="{Binding Description}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   FontFamily="Microsoft YaHei" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- 进入测试提示 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="进入测试" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" FontFamily="Microsoft YaHei"/>
                                        <md:PackIcon Kind="ChevronRight" Width="18" Height="18"
                                                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 占位卡片 -->
                <Button Height="110" Margin="0,2,0,0" Style="{StaticResource DashedButtonStyle}"
                        Command="{Binding AddToolCommand}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentLightBrush}"
                                HorizontalAlignment="Center">
                            <md:PackIcon Kind="Plus" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="预留测试项位置" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" FontFamily="Microsoft YaHei" Margin="0,10,0,0"/>
                        <TextBlock Text="按需添加更多辅助测试" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" FontFamily="Microsoft YaHei" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
