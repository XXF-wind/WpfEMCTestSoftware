<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views"
      xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls" 
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
    x:Class="WpfEMCTestSoftware.Views.FieldStrengthMeterParaPage"
      mc:Ignorable="d" 
      DataContext="{Binding FieldStrengthMeterParaViewModel, Source={StaticResource Locator}}"
      d:DesignHeight="828" d:DesignWidth="613"
      Title="FieldStrengthMeterParaPage"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <TextBlock Text="{DynamicResource CalibrationFactorTitle}" Margin="10,87,10,0" Height="46" VerticalAlignment="Top" FontSize="30"/>
        <StackPanel Height="56" VerticalAlignment="Top" Orientation="Horizontal" Margin="10,138,13,0">
            <TextBox Text="{Binding MfieldStrengthMeterPara.CalibrationFactor}" VerticalAlignment="Center" 
                     FontSize="30" Width="514" Background="{DynamicResource InputBackgroundBrush}" VerticalContentAlignment="Center" 
                     HorizontalContentAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Controls:StatusIconTextButton Label="" Background="{x:Null}" Foreground="{DynamicResource AccentBrush}" IconSize="40" 
                                           Margin="10" Width="39" Command="{Binding FileInputCommand}" />
        </StackPanel>

        <mah:NumericUpDown Width="134" Height="46" Background="{x:Null}" Margin="289,264,0,0" FontSize="32"
            Value="{Binding MfieldStrengthMeterPara.SampleTime, Mode=TwoWay}" VerticalAlignment="Top" HorizontalAlignment="Left"
            Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{DynamicResource SamplingTimeTitle}" Margin="10,267,0,0" Height="40" VerticalAlignment="Top" 
            HorizontalAlignment="Left" Width="268" TextAlignment="Right" FontSize="32"/>
        <TextBlock Text="ms" Margin="438,267,0,0" Height="40" VerticalAlignment="Top" 
            HorizontalAlignment="Left" Width="50" TextAlignment="Left" FontSize="32"
            Foreground="{DynamicResource TextSecondaryBrush}"/>

    </Grid>
</Page>