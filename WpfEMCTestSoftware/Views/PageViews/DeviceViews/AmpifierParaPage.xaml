<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WpfEMCTestSoftware.ViewModels"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    DataContext="{Binding Source={StaticResource Locator}, Path=AmpifierParaViewModel}"
    x:Class="WpfEMCTestSoftware.Views.AmpifierParaPage"
    mc:Ignorable="d" FontSize="30"
    d:DesignHeight="858" d:DesignWidth="688"
    Title="AmpifierParaPage"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Viewbox>
        <Grid Height="858" Width="688">
            <Grid.RowDefinitions>
                <RowDefinition Height="166*"/>
                <RowDefinition Height="159*"/>
                <RowDefinition Height="102*"/>
                <RowDefinition Height="131*"/>
                <RowDefinition Height="270*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource ForWardCouplingTitle}" Margin="28,0,0,0" Height="40" 
                           VerticalAlignment="Top" HorizontalAlignment="Left" Width="545"/>
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <RadioButton x:Name="radioButton1" Content="{DynamicResource FixedValueTitle}" Margin="60,0,0,0"
                                 Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Width="200" IsChecked="{Binding IsFixdF, Mode=TwoWay}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="radioButton" Content="{DynamicResource FileImportTitle}" Margin="60,0,0,0" 
                                 Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Width="200" IsChecked="{Binding IsFileF,Mode=TwoWay}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Height="56" Margin="0,5,0,0" VerticalAlignment="Top"
                    Width="521" Orientation="Horizontal" Grid.Row="0"
                Visibility="{Binding IsChecked, Converter={StaticResource myBoolToVisibilityConverter}, ElementName=radioButton1}">
                    <mah:NumericUpDown Width="170" Background="{x:Null}" Value="{Binding FCouplvalue,Mode=TwoWay}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="dB" Margin="10" VerticalAlignment="Center" FontSize="30"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Height="56" Margin="0,5,0,0" VerticalAlignment="Top"
                    Orientation="Horizontal" Width="521" Grid.Row="0"
            Visibility="{Binding IsChecked, ElementName=radioButton,Converter={StaticResource myBoolToVisibilityConverter}}">
                    <TextBox Text="{Binding FCouplFile}" VerticalAlignment="Center" FontSize="30" Width="468"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Controls:StatusIconTextButton Label="" Background="{x:Null}" Foreground="{DynamicResource AccentBrush}" 
                                           IconSize="40" Margin="10" Width="39"
                                           Command="{Binding FileInputCommand}" CommandParameter="F"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="{DynamicResource ReverseCouplingTitle}" Margin="28,0,0,0" Height="40" VerticalAlignment="Top" 
            HorizontalAlignment="Left" Grid.Row="1" Width="545"/>
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <RadioButton x:Name="rbtn1" Content="{DynamicResource FixedValueTitle}" Margin="60,0,0,0"
                     Height="39" VerticalAlignment="Top" HorizontalAlignment="Left" Width="200" IsChecked="{Binding IsFixdR,Mode=TwoWay}"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="rbtn" Content="{DynamicResource FileImportTitle}" Margin="60,0,0,0"
                     Height="39" VerticalAlignment="Top" HorizontalAlignment="Left" Width="227" IsChecked="{Binding IsFileR,Mode=TwoWay}"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Height="56" Margin="0,5,0,0" VerticalAlignment="Top"
                    Width="521" Orientation="Horizontal" Grid.Row="1" 
            Visibility="{Binding IsChecked, Converter={StaticResource myBoolToVisibilityConverter}, ElementName=rbtn1}">
                    <mah:NumericUpDown Width="170" Background="{x:Null}" Value="{Binding RCouplvalue,Mode=TwoWay}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="dB" Margin="10" VerticalAlignment="Center" FontSize="30"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Height="56" Margin="0,5,0,0" VerticalAlignment="Top"
            Orientation="Horizontal" Width="523"  Grid.Row="1"
            Visibility="{Binding IsChecked, ElementName=rbtn,Converter={StaticResource myBoolToVisibilityConverter}}">
                    <TextBox Text="{Binding RCouplFile}" VerticalAlignment="Center" FontSize="30" Width="468" 
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Controls:StatusIconTextButton Label="" Background="{x:Null}" Foreground="{DynamicResource AccentBrush}" 
                                   IconSize="40" Margin="10" Width="39"
                                   Command="{Binding FileInputCommand}" CommandParameter="R"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{DynamicResource MaxInputValueTitle}" Margin="28,0,0,0" Height="40" VerticalAlignment="Top" 
            HorizontalAlignment="Left" Grid.Row="2" Width="545"/>
            <StackPanel Height="56" VerticalAlignment="Top" Orientation="Horizontal"  Grid.Row="2" 
                        HorizontalAlignment="Center" Width="522" Margin="0,45,0,0">
                <TextBox Text="{Binding MaxInputValueFile}" VerticalAlignment="Center" FontSize="30" Width="468"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Controls:StatusIconTextButton Label="" Background="{x:Null}" Foreground="{DynamicResource AccentBrush}" IconSize="40" 
                                               Margin="10" Width="39" Command="{Binding FileInputCommand}" 
                                               CommandParameter="M"/>
            </StackPanel>
            <StackPanel Grid.Row="3" >
                <TextBlock Text="{DynamicResource SWPStartPower}" Height="40" VerticalAlignment="Center" 
                HorizontalAlignment="Left" Margin="10"/>
                <StackPanel Orientation="Horizontal" Width="535">
                    <mah:NumericUpDown Width="134" Height="46" Background="{x:Null}" Margin="40,0,0,0"
                        Value="{Binding AmpifierPara.ProtectionPower,Mode=TwoWay}"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Margin="10" VerticalAlignment="Center" FontSize="30" Height="46" Width="115" 
                              ItemsSource="{Binding PowerUnits}" SelectedValue="{Binding PowerUnit,Mode=TwoWay}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <GroupBox Grid.Row="4" Header="{DynamicResource RatedPowerTitle}" FontSize="24"
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <Grid>
                    <RadioButton x:Name="rbtnPower1" Content="{DynamicResource FullFrequencyTitle}" Margin="72,3,0,0"
                             Height="37" VerticalAlignment="Top" HorizontalAlignment="Left" Width="236"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="rbtnPower" Content="{DynamicResource FrequencyDivisionTitle}"
                             Margin="0,5,48,0" Height="36" VerticalAlignment="Top" HorizontalAlignment="Right" Width="227"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Vertical" Margin="0,45,0,0" 
                            Visibility="{Binding IsChecked, Converter={StaticResource myBoolToVisibilityConverter}, ElementName=rbtnPower}" Height="181" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Height="56" Width="583">
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}" 
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[0].StartFreq}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="~" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[0].EndFreq}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="-&gt;" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[0].RatedPower}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox FontSize="30" Width="115" Height="40" Margin="5" ItemsSource="{Binding PowerUnits}"
                                  SelectedValue="{Binding PowerUnit, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="56" Width="583" Margin="0,2">
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[1].StartFreq}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="~" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[1].EndFreq}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="-&gt;" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[1].RatedPower}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox FontSize="30" Width="115" Height="40" Margin="5" ItemsSource="{Binding PowerUnits}"
                            SelectedValue="{Binding PowerUnit, Mode=TwoWay}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Height="56" Width="583" Margin="0,2" 
                                Visibility="{Binding AmpifierPara.RatedPowerInFreq[2].ID,
                        Converter={StaticResource valueToVisibilityConverter},ConverterParameter=2}">
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[2].StartFreq}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="~" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[2].EndFreq}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="-&gt;" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                                           Value="{Binding AmpifierPara.RatedPowerInFreq[2].RatedPower}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox FontSize="30" Width="115" Height="40" Margin="5"
                            ItemsSource="{Binding PowerUnits}" SelectedValue="{Binding PowerUnit, Mode=TwoWay}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,45,10,0" Height="56"
                            Visibility="{Binding IsChecked, Converter={StaticResource myBoolToVisibilityConverter},
                        ElementName=rbtnPower1}" VerticalAlignment="Top">
                        <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}" 
                            Value="{Binding AmpifierPara.RatedPowerInFreq[0].StartFreq}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="~" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                            Value="{Binding AmpifierPara.RatedPowerInFreq[0].EndFreq}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="-&gt;" FontSize="32" Height="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <mah:NumericUpDown Width="134" Height="38" Background="{x:Null}"
                            Value="{Binding AmpifierPara.RatedPowerInFreq[0].RatedPower}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox FontSize="30" Width="115" Height="40" Margin="5" ItemsSource="{Binding PowerUnits}"
                            SelectedValue="{Binding PowerUnit, Mode=TwoWay}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Viewbox>
</Page>