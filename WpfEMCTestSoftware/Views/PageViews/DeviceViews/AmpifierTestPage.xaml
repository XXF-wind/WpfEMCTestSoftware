<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    x:Class="WpfEMCTestSoftware.Views.AmpifierTestPage"
    mc:Ignorable="d" FontSize="30"
    DataContext="{Binding AmpifierTestViewModel, Source={StaticResource Locator}}"
    d:DesignHeight="910" d:DesignWidth="529"
    Title="AmpifierTestPage"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <GroupBox Header="{DynamicResource TestTitle}" BorderBrush="{DynamicResource BorderBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}">
        <Viewbox>
            <Grid Width="529" Height="910">
                <StackPanel Orientation="Vertical" Margin="0,30,0,20">
                    <StackPanel Orientation="Horizontal" MinHeight="50">
                        <ToggleButton IsChecked="{Binding IsConnected}" Content="{Binding ConnectbtnText}"
                                  Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}" Width="100" Margin="50,0,0,0"
                                  Command="{Binding ConnectDeviceCommand}"/>
                        <ToggleButton IsChecked="{Binding IsRF}" Width="100" Content="{Binding RfbtnText}"
                                  Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}" Margin="200,0,0,0"
                                  Command="{Binding RFSwitchCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" MinHeight="50" Margin="0,20,0,20">
                        <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">
                        <Run Language="zh-cn" Text="{DynamicResource ReadTitle}"/><Run Text="{DynamicResource FrequencyTitle}"/>
                        </TextBlock>
                        <TextBox Text="{Binding FreqValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"
                             Margin="10,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="MHz" VerticalAlignment="Center" Margin="10,0,0,0" Width="70"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Controls:StatusIconTextButton Label="{DynamicResource ReadTitle}" IconSize="40"
                                                   IconKind="ArrowLeftCircleOutline" Background="{x:Null}" 
                                                   Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                                                   Command="{Binding ReadDataCommand}" CommandParameter="Freq"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" MinHeight="50" Margin="0,20,0,20">
                        <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">
                        <Run Language="zh-cn" Text="{DynamicResource SendTitle}"/><Run Text="{DynamicResource FrequencyTitle}"/></TextBlock>
                        <mah:NumericUpDown Width="110" Height="46" Background="{x:Null}" Margin="10,0,0,0" FontSize="36"
                                       Value="{Binding SetFreq, Mode=TwoWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="MHz" VerticalAlignment="Center" Margin="10,0,0,0" Width="70"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Controls:StatusIconTextButton Label="{DynamicResource SendTitle}" IconSize="40" 
                                                   IconKind="SendCircleOutline" Background="{x:Null}" 
                                                   Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                                                   Command="{Binding SendDataCommand}" CommandParameter="Freq"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" MinHeight="50" Margin="0,20,0,20">
                        <TextBlock Text="{DynamicResource ForwardPowerTitle}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Text="{Binding FreqValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"
                        Margin="10,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center"
                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="W" VerticalAlignment="Center" Margin="10,0,0,0" Width="70"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Controls:StatusIconTextButton Label="{DynamicResource ReadTitle}" IconSize="40"
                                                   IconKind="ArrowLeftCircleOutline" Background="{x:Null}" 
                                                   Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                                                   Command="{Binding ReadDataCommand}" CommandParameter="FPower"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" MinHeight="50" Margin="0,20,0,20">
                        <TextBlock Text="{DynamicResource ReversePowerTitle}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Text="{Binding FreqValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="110" Margin="10,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="W" VerticalAlignment="Center" Margin="10,0,0,0" Width="70"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Controls:StatusIconTextButton Label="{DynamicResource ReadTitle}" IconSize="40" 
                                                   IconKind="ArrowLeftCircleOutline" Background="{x:Null}" 
                                                   Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                                                   Command="{Binding ReadDataCommand}" CommandParameter="RPower"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" MinHeight="50" Margin="0,20,0,20">
                        <TextBlock Text="{DynamicResource AlarmStatusTitle}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Text="{Binding WarnStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="190" Margin="10,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Controls:StatusIconTextButton Label="{DynamicResource ReadTitle}" IconSize="40" 
                                                   IconKind="ArrowLeftCircleOutline" Background="{x:Null}" 
                                                   Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"
                                                   Command="{Binding ReadDataCommand}" CommandParameter="Warn"/>

                    </StackPanel>
                </StackPanel>
            </Grid>
        </Viewbox>
    </GroupBox>
</Page>