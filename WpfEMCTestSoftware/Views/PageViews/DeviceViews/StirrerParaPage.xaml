<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views.PageViews.DeviceViews"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
      x:Class="WpfEMCTestSoftware.Views.PageViews.DeviceViews.StirrerParaPage"
      DataContext="{Binding StirrerParaViewModel ,Source={StaticResource Locator}}"
      mc:Ignorable="d" 
      d:DesignHeight="828" d:DesignWidth="613"    
      Title="StirrerParaPage"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" MinWidth="65"/>
            <ColumnDefinition Width="13*" MinWidth="90"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <mah:NumericUpDown Grid.Column="1" Background="{x:Null}" FontSize="32"
            Value="{Binding MStirrerPara.StepAngeleSet, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,5,5,5"/>
        <TextBlock Text="{DynamicResource StepAngleTitle}"  Height="40" VerticalAlignment="Center" 
            HorizontalAlignment="Left" TextAlignment="Right" FontSize="32"/>
        <TextBlock Grid.Column="2" Text="度"  VerticalAlignment="Center" 
            HorizontalAlignment="Center"  TextAlignment="Center" FontSize="32"
            Foreground="{DynamicResource TextSecondaryBrush}"/>
        
        <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Background="{x:Null}" FontSize="32"
    Value="{Binding MStirrerPara.MinAngle, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,5,5,5"/>
        <TextBlock  Grid.Row="1" Text="{DynamicResource MinAngleTitle}"  Height="40" VerticalAlignment="Center" 
    HorizontalAlignment="Left"  TextAlignment="Right" FontSize="32"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="度"  VerticalAlignment="Center" 
    HorizontalAlignment="Center"  TextAlignment="Center" FontSize="32"
    Foreground="{DynamicResource TextSecondaryBrush}"/>

        <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Background="{x:Null}" FontSize="32"
Value="{Binding MStirrerPara.MaxAngle, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,5,5,5"/>
        <TextBlock  Grid.Row="2" Text="{DynamicResource MaxAngleTitle}"  Height="40" VerticalAlignment="Center" 
HorizontalAlignment="Left"  TextAlignment="Right" FontSize="32"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="度"  VerticalAlignment="Center" 
HorizontalAlignment="Center"  TextAlignment="Center" FontSize="32"
Foreground="{DynamicResource TextSecondaryBrush}"/>
        <mah:NumericUpDown Grid.Row="3" Grid.Column="1" Background="{x:Null}" FontSize="32"
Value="{Binding MStirrerPara.RotateSpeed, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,5,5,5"/>
        <TextBlock  Grid.Row="3" Text="{DynamicResource RotateAngleTitle}"  Height="40" VerticalAlignment="Center" 
HorizontalAlignment="Left"  TextAlignment="Right" FontSize="32"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="度/秒"  VerticalAlignment="Center" 
HorizontalAlignment="Center"  TextAlignment="Center" FontSize="32"
Foreground="{DynamicResource TextSecondaryBrush}"/>

    </Grid>
</Page>