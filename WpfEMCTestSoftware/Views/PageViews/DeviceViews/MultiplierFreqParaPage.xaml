<Page x:Class="WpfEMCTestSoftware.Views.MultiplierFreqParaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfEMCTestSoftware.Views" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      DataContext="{Binding Source={StaticResource Locator}, Path=MultiplierFreqParaViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="828" d:DesignWidth="613"
      Title="MultiplierFreqPage"
      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <mah:NumericUpDown Width="134" Height="46" Background="{x:Null}" Margin="289,159,0,0" FontSize="32"
                           Value="{Binding MultiplierFreqPara.MaxAtt,Mode=TwoWay}" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
        <mah:NumericUpDown Width="134" Height="46" Background="{x:Null}" Margin="289,264,0,0" FontSize="32"
                           Value="{Binding MultiplierFreqPara.StepAtt,Mode=TwoWay}" VerticalAlignment="Top" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{DynamicResource MaxAttTitle}" Margin="10,162,0,0" Height="40" VerticalAlignment="Top" 
                   HorizontalAlignment="Left" Width="268" TextAlignment="Right" FontSize="32"/>
        <TextBlock Text="{DynamicResource AttStepTitle}" Margin="10,267,0,0" Height="40" VerticalAlignment="Top" 
                   HorizontalAlignment="Left" Width="268" TextAlignment="Right" FontSize="32"/>
        <TextBlock Text="dB" Margin="438,162,0,0" Height="40" VerticalAlignment="Top" 
           HorizontalAlignment="Left" Width="50" TextAlignment="Left" FontSize="32"
           Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="dB" Margin="438,267,0,0" Height="40" VerticalAlignment="Top" 
           HorizontalAlignment="Left" Width="50" TextAlignment="Left" FontSize="32"
           Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Page>