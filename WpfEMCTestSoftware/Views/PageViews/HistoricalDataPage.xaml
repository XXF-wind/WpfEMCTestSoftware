<Page x:Class="WpfEMCTestSoftware.Views.HistoricalDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      DataContext="{Binding HistoricalDataViewModel, Source={StaticResource Locator}}"
      mc:Ignorable="d" FontSize="24"
      d:DesignHeight="910" d:DesignWidth="1840"
      Title="HistoricalDataPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ListView d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,1,5,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Column="1" Margin="0,0,15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
        </Grid>
        <ListView ItemsSource="{Binding DisplayInfo}" Margin="0,1,0,0" Grid.Column="2">
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <!-- 列头默认样式 -->
                            <Setter Property="Background" Value="#E8F4FD"/>
                            <Setter Property="Foreground" Value="#1F4E79"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#C4D8E8"/>
                            <!-- 列头鼠标悬浮样式 -->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B3D8F5"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                                <!-- 列头选中样式（点击排序时生效） -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#7CB9E8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>

                    <GridViewColumn Header="{DynamicResource ParameterTitle}" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 自定义单元格布局：图片+文字 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/user.png" Width="20" Height="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding FirstValue}" FontSize="12" Foreground="#212121"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource ValueTitle}" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 自定义单元格布局：图片+文字 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/user.png" Width="20" Height="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding FirstValue}" FontSize="12" Foreground="#212121"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>

            </ListView.View>
            <!-- 列内容（ListViewItem）样式：修改单元格数据显示样式 -->
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <!-- 单元格默认样式 -->
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                    <Style.Triggers>
                        <!-- 奇数行（索引0、2、4...） -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                        <!-- 偶数行（索引1、3、5...） -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9FBFD"/>
                        </Trigger>
                        <!-- 鼠标悬浮样式 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#0A6ED1"/>
                        </Trigger>
                        <!-- 选中行样式 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2196F3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#1976D2"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
