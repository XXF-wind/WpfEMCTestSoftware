<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="clr-namespace:Company.UI.Controls;assembly=Company.UI.Controls"
    xmlns:core="clr-namespace:WpfEMCTestSoftware.Core"
    xmlns:viewmodels="clr-namespace:WpfEMCTestSoftware.ViewModels"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    DataContext="{Binding Source={StaticResource Locator}, Path=MainViewModel}"    
    x:Class="WpfEMCTestSoftware.MainWindow"
    mc:Ignorable="d" 
    Title="{DynamicResource MainTitle}" Height="720" Width="1280" MouseDown="Window_MouseDown" 
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" WindowState="Maximized">

    <Viewbox Stretch="Fill">
        <Grid Height="1018" Width="1920" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- 整体页面背景 (跟随主题) -->
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource PageBackgroundColor}"/>
            </Grid.Background>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="19*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════ 顶部标题栏 (暗色 navy 风格) ═══════════════ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource HeaderBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：Logo + 标题 -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <!-- Logo 方块 -->
                        <Border Width="42" Height="42" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                            <TextBlock Text="SP" FontSize="20" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </Border>
                        <!-- 公司名 + 副标题 -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompanyName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeaderFgBrush}"
                                       FontFamily="Microsoft YaHei"/>
                            <TextBlock Text="Sinpel EMC 测试系统" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="Microsoft YaHei" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：页面标题 -->
                    <TextBlock Grid.Column="1" Text="{Binding PageTitle}" 
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderFgBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei"/>

                    <!-- 右侧：功能按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- 快速开始 -->
                        <!-- 主题切换 -->
                        <Border Padding="8,5" CornerRadius="16"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,8,0"
                                ToolTip="切换主题 (浅色/深色/海洋蓝)"
                                Background="Transparent"
                                IsEnabled="{Binding NavigationEnabled}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding CycleThemeCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="PaletteOutline" Foreground="{DynamicResource HeaderFgBrush}"  Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ThemeDisplayName}" FontSize="13"
                                           Foreground="{DynamicResource HeaderFgBrush}"
                                           VerticalAlignment="Center" FontFamily="Microsoft YaHei"/>
                            </StackPanel>
                        </Border>
                        <!-- 语言切换 -->
                        <Border Padding="8,5" CornerRadius="16"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="切换语言"
                                Background="Transparent"
                                IsEnabled="{Binding NavigationEnabled}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding ChangeLanguageCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Web" Margin="0,0,6,0" Foreground="{DynamicResource HeaderFgBrush}"/>
                                <TextBlock Text="语言" FontSize="13"
                                           Foreground="{DynamicResource HeaderFgBrush}"
                                           VerticalAlignment="Center" FontFamily="Microsoft YaHei"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ 导航栏 ═══════════════ -->
            <Controls:NavigationPage x:Name="navigation" Margin="0,0,0,5" 
                                     Foreground="{DynamicResource AccentBrush}" 
                                     FontSize="24" Grid.Row="1"
                                     IsEnabled="{Binding NavigationEnabled}"
                                     ToolTip="测试运行中，导航已锁定"
                                     ToolTipService.ShowOnDisabled="True">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="OnClickItem">
                        <core:EventToCommandAction
                        Command="{Binding ClickItemCommand}" 
                        PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Controls:NavigationPage>

            <!-- ═══════════════ 页面内容区 ═══════════════ -->
            <Frame Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden" Grid.Row="1" 
                   Grid.Column="1" 
                   Background="{DynamicResource SurfaceAltBrush}"/>

            <!-- ═══════════════ 底部状态栏 ═══════════════ -->
            <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,0"
                       Background="{DynamicResource StatusBarBgBrush}">
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}"
                               Text="{DynamicResource VersionTitle}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}"
                               Text="{Binding Version}" Padding="1,0,5,0"/>
                </StatusBarItem>
                <Separator Background="{DynamicResource BorderBrush}"/>
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding URL}" Padding="1,0,5,2" FontWeight="Bold"/>
                </StatusBarItem>
                <Separator Background="{DynamicResource BorderBrush}"/>
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}"
                               Text="{DynamicResource PhoneTitle}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}"
                               Text="{Binding Phone}" Padding="1,0,5,0"/>
                </StatusBarItem>
                <Separator Background="{DynamicResource BorderBrush}"/>
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}"
                               Text="{DynamicResource EmailTitle}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}"
                               Text="{Binding Email}" Padding="1,0,5,0"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurTime}" FontFamily="Microsoft YaHei" FontSize="16" 
                               Foreground="{DynamicResource StatusBarFgBrush}" Padding="5,0,5,0"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Viewbox>
</Window>
